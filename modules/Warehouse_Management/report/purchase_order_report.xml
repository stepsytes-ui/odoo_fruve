<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_purchase_order" model="report.paperformat">
        <field name="name">Orden de compra A4 vertical</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_spacing">0</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_purchase_order" model="ir.actions.report">
        <field name="name">Orden de Compra</field>
        <field name="model">purchase.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">Warehouse_Management.purchase_order_report</field>
        <field name="report_file">Warehouse_Management.purchase_order_report</field>
        <field name="print_report_name">'Orden de compra - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="paperformat_purchase_order"/>
    </record>

    <template id="purchase_order_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="request">
                <t t-set="company" t-value="request.company_id or res_company"/>
                <style>
                    @font-face {
                        font-family: 'OCPurchaseLato';
                        src: url('/web/static/fonts/lato/Lato-Reg-webfont.ttf') format('truetype');
                        font-weight: 400;
                    }
                    @font-face {
                        font-family: 'OCPurchaseLato';
                        src: url('/web/static/fonts/lato/Lato-Bol-webfont.ttf') format('truetype');
                        font-weight: 700;
                    }
                    .oc-report {
                        font-family: 'OCPurchaseLato', Arial, sans-serif;
                        font-size: 8px;
                        color: #222;
                    }
                </style>
                <div class="page oc-report">
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 8px;">
                        <tr>
                            <td style="width: 47%; vertical-align: top;">
                                <img t-if="company.logo"
                                     t-att-src="image_data_uri(company.logo)"
                                     style="max-height: 55px; max-width: 180px;"
                                     alt="Logo de la empresa"/>
                            </td>
                            <td style="width: 53%; text-align: right; vertical-align: top;">
                                <strong style="font-size: 13px;"
                                        t-out="request.get_purchase_order_report_text(company.name)"/>
                                <div style="font-size: 8px; margin-top: 3px; white-space: pre-line;"
                                     t-out="request.get_purchase_order_report_text(company.partner_id._display_address(without_company=True))"/>
                            </td>
                        </tr>
                    </table>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 8px;">
                        <tr>
                            <td style="width: 62%; border-bottom: 2px solid #287a3d;">
                                <strong style="font-size: 20px; color: #287a3d;">ORDEN DE COMPRA</strong>
                            </td>
                            <td style="width: 18%; border: 1px solid #777; padding: 4px;">
                                <strong>FOLIO</strong>
                            </td>
                            <td style="width: 20%; border: 1px solid #777; padding: 4px; font-size: 12px; font-weight: bold;"
                                t-out="request.name"/>
                        </tr>
                        <tr>
                            <td style="border-bottom: 2px solid #287a3d;"> </td>
                            <td style="border: 1px solid #777; border-top: 0; padding: 4px;">
                                <strong>REVISION</strong>
                            </td>
                            <td style="border: 1px solid #777; border-top: 0; padding: 4px;">00</td>
                        </tr>
                    </table>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 8px;">
                        <tr>
                            <td style="width: 18%; padding: 5px; border: 1px solid #b8c9ba; background: #eaf4ec;">
                                <strong>Empresa:</strong>
                            </td>
                            <td style="width: 82%; padding: 5px; border: 1px solid #bbb;"
                                t-out="request.get_purchase_order_report_text(company.name)"/>
                        </tr>
                        <tr>
                            <td style="padding: 5px; border: 1px solid #b8c9ba; background: #eaf4ec;">
                                <strong>Tipo de pago:</strong>
                            </td>
                            <td style="padding: 5px; border: 1px solid #bbb;"
                                t-out="request.get_purchase_order_report_text(dict(request._fields['payment_type'].selection).get(request.payment_type, ''))"/>
                        </tr>
                        <tr>
                            <td style="padding: 5px; border: 1px solid #b8c9ba; background: #eaf4ec;">
                                <strong>Importe total:</strong>
                            </td>
                            <td style="padding: 5px; border: 1px solid #bbb; font-size: 12px; font-weight: bold;"
                                t-out="'$ {:,.2f}'.format(request.total_amount)">
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 5px; border: 1px solid #b8c9ba; background: #eaf4ec;">
                                <strong>Comentarios:</strong>
                            </td>
                            <td style="padding: 7px; border: 1px solid #bbb; white-space: pre-line; line-height: 1.4;"
                                t-out="request.get_purchase_order_report_text(request.comments)"/>
                        </tr>
                    </table>

                    <table style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-bottom: 6px;">
                        <thead>
                            <tr style="background: #287a3d; color: #fff;">
                                <th style="width: 6%; padding: 4px; border: 1px solid #1f5f30;">Cant.</th>
                                <th style="width: 7%; padding: 4px; border: 1px solid #1f5f30;">Unidad</th>
                                <th style="width: 20%; padding: 4px; border: 1px solid #1f5f30;">Descripcion</th>
                                <th style="width: 10%; padding: 4px; border: 1px solid #1f5f30;">Marca</th>
                                <th style="width: 9%; padding: 4px; border: 1px solid #1f5f30;">Modelo</th>
                                <th style="width: 15%; padding: 4px; border: 1px solid #1f5f30;">Proveedor</th>
                                <th style="width: 11%; padding: 4px; border: 1px solid #1f5f30;">Precio unitario</th>
                                <th style="width: 11%; padding: 4px; border: 1px solid #1f5f30;">Subtotal</th>
                                <th style="width: 11%; padding: 4px; border: 1px solid #1f5f30;">Recibido</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="request.line_ids" t-as="line" style="page-break-inside: avoid;">
                                <td style="padding: 4px; border: 1px solid #bbb; text-align: right;"
                                    t-out="line.quantity"/>
                                <td style="padding: 4px; border: 1px solid #bbb;"
                                    t-out="request.get_purchase_order_report_text(line.unit_id.name)"/>
                                <td style="padding: 4px; border: 1px solid #bbb; word-wrap: break-word;"
                                    t-out="request.get_purchase_order_report_text(line.description)"/>
                                <td style="padding: 4px; border: 1px solid #bbb;"
                                    t-out="request.get_purchase_order_report_text(line.brand_id.display_name)"/>
                                <td style="padding: 4px; border: 1px solid #bbb;"
                                    t-out="request.get_purchase_order_report_text(line.model_name)"/>
                                <td style="padding: 4px; border: 1px solid #bbb;"
                                    t-out="request.get_purchase_order_report_text(line.vendor_id.display_name)"/>
                                <td style="padding: 4px; border: 1px solid #bbb; text-align: right;"
                                    t-out="'$ {:,.2f}'.format(line.unit_price)"/>
                                <td style="padding: 4px; border: 1px solid #bbb; text-align: right;"
                                    t-out="'$ {:,.2f}'.format(line.subtotal)"/>
                                <td style="padding: 4px; border: 1px solid #bbb; text-align: center;">
                                    <span style="display: inline-block; width: 12px; height: 12px; border: 1px solid #333; vertical-align: middle;">
                                        <svg t-if="request.state == 'recibida' and line.received_qty &gt; 0 and line.receipt_status not in ('defectuoso', 'faltante')"
                                             width="10" height="10" viewBox="0 0 12 12">
                                            <path d="M2 6 L5 9 L10 2"
                                                  fill="none"
                                                  stroke="#287a3d"
                                                  stroke-width="2"/>
                                        </svg>
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div style="border: 1px solid #bbb; padding: 5px; margin-top: 4px; font-weight: bold;">
                        NOTA: CUANDO SEAN REFACCIONES DEBERAN DE INCLUIR NUM. DE PARTE, MODELO, MARCA Y EL NOMBRE DEL PROVEEDOR.
                    </div>
                    <div style="padding: 7px 3px; font-size: 12px; font-weight: bold; text-align: center; color: #287a3d;">
                        PARA FACTURAS FAVOR DE ENVIAR CORREO A:
                        <span t-out="request.get_purchase_order_invoice_email()"/>
                    </div>

                    <table style="width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 12px 0; margin: 16px 0 12px;">
                        <tr>
                            <td style="height: 145px; padding: 0 4px; text-align: center; vertical-align: bottom;">
                                <div style="height: 105px;"></div>
                                <div style="border-top: 1px solid #555; padding-top: 5px;">
                                    <strong>Solicitante</strong>
                                    <div style="min-height: 26px; padding-top: 3px;"
                                         t-out="request.get_purchase_order_report_text(request.solicitante_id.name)"/>
                                </div>
                            </td>
                            <td style="height: 145px; padding: 0 4px; text-align: center; vertical-align: bottom;">
                                <div style="height: 105px;"></div>
                                <div style="border-top: 1px solid #555; padding-top: 5px;">
                                    <strong>Supervisor de Area</strong>
                                    <div style="min-height: 26px; padding-top: 3px;"
                                         t-out="request.get_purchase_order_report_text(request.supervisor_id.display_name)"/>
                                </div>
                            </td>
                            <td style="height: 145px; padding: 0 4px; text-align: center; vertical-align: bottom;">
                                <div style="height: 105px;"></div>
                                <div style="border-top: 1px solid #555; padding-top: 5px;">
                                    <strong>Autoriza</strong>
                                    <div style="min-height: 26px; padding-top: 3px;"
                                         t-out="request.get_purchase_order_report_text(request.authorizer_id.name)"/>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 8px;">
                        <tr>
                            <td style="padding: 4px; border: 1px solid #777; background: #eaf4ec;">
                                <strong>Otros comentarios</strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="min-height: 55px; height: 55px; padding: 6px; border: 1px solid #777;">
                                <div t-if="request.decision_comments"
                                     style="font-size: 14px; color: #444; border-bottom: 1px solid #ddd; padding-bottom: 5px; margin-bottom: 6px; line-height: 1.3;">
                                    <strong t-out="request.get_purchase_order_report_text(request.decision_comment_user_id.name)"/>
                                    <span> - </span>
                                    <span t-field="request.decision_comment_date"
                                          t-options="{'widget': 'datetime'}"/>
                                </div>
                                <div style="white-space: pre-line;"
                                     t-out="request.get_purchase_order_report_text(request.decision_comments)"/>
                            </td>
                        </tr>
                    </table>

                    <div style="font-size: 10px; font-weight: bold; text-align: center; border-top: 2px solid #287a3d; padding-top: 5px;">
                        ESTA ORDEN DE COMPRA DEBERA ANEXARSE EN LA FACTURA PARA PODER TRAMITAR SU PAGO
                    </div>
                    <div style="text-align: center; margin-top: 12px; page-break-inside: avoid;">
                        <img t-att-src="request.get_purchase_order_barcode_uri()"
                             style="width: 240px; height: 36px;"/>
                        <div style="font-size: 10px; font-weight: bold; margin-top: 2px;"
                             t-out="request.name"/>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
