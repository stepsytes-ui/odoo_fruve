<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_inherit_customer_totals" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@name='so_total_summary']//t[@t-call='sale.document_tax_totals']" position="replace">
            <tr>
                <td><strong>Subtotal</strong></td>
                <td class="text-end">
                    <span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                </td>
            </tr>
            <tr>
                <td><strong>IVA</strong></td>
                <td class="text-end">
                    <span t-field="doc.amount_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                </td>
            </tr>
            <tr class="border-black border-top">
                <td><strong>Total</strong></td>
                <td class="text-end">
                    <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                </td>
            </tr>
        </xpath>
    </template>
</odoo>
