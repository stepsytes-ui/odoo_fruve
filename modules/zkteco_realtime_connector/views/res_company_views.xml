<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_zkteco_inherit" model="ir.ui.view">
        <field name="name">res.company.form.zkteco.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Dispositivos Checadores">
                    <group>
                        <group>
                            <field name="timezone" required="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="attendance_reports_base_url" placeholder="http://192.168.1.239:8069"/>
                        </group>
                    </group>
                    <field name="device_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="name" required="1"/>
                            <field name="serial_number" required="1"/>
                            <field name="location"/>
                            </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>