<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="zkteco_realtime_connector.AttendanceKanbanDashboard" owl="1">
        <div class="o_hr_attendance_dashboard container-fluid p-3 bg-light" style="margin-bottom: 16px; border-radius: 8px;">
            
            <div t-if="state.loading" class="text-center">
                <i class="fa fa-spinner fa-spin fa-2x text-primary"/>
                <p class="mt-2">Cargando estadísticas...</p>
            </div>

            <div t-if="!state.loading">
                <div class="row mb-3 align-items-center">
                    <div class="col-md-6">
                        <h4 class="fw-bold mb-0">Estatus de Asistencia</h4>
                    </div>
                    <div class="col-md-6 text-end d-flex align-items-center justify-content-end gap-2">
                        <label class="fw-bold small me-2">Desde:</label>
                        <input type="date" t-model="state.start_date" class="form-control form-control-sm w-auto"/>

                        <label class="fw-bold small ms-2 me-2">Hasta:</label>
                        <input type="date" t-model="state.end_date" class="form-control form-control-sm w-auto"/>

                        <button class="btn btn-sm btn-primary ms-2" t-on-click="_onRefreshClick" title="Refrescar">
                            <i class="fa fa-refresh"/>
                        </button>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-2">
                        <div class="card shadow-sm h-100">
                            <div class="card-body text-center p-3">
                                <h5 class="card-title text-uppercase text-muted small">Ausencias Justificadas</h5>
                                <p class="fs-1 fw-bold text-warning mb-0">
                                    <t t-esc="state.stats.excused_count"/>
                                </p>
                                <small class="text-muted">(Permiso, Vacaciones, etc.)</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-2">
                        <div class="card shadow-sm h-100">
                            <div class="card-body text-center p-3">
                                <h5 class="card-title text-uppercase text-muted small">Presentes</h5>
                                <p class="fs-1 fw-bold text-success mb-0">
                                    <t t-esc="state.stats.present_count"/>
                                </p>
                                <small class="text-muted">(A tiempo o Retardo)</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-2">
                        <div class="card shadow-sm h-100">
                            <div class="card-body text-center p-3">
                                <h5 class="card-title text-uppercase text-muted small">Faltas</h5>
                                <p class="fs-1 fw-bold text-danger mb-0">
                                    <t t-esc="state.stats.unexcused_count"/>
                                </p>
                                <small class="text-muted">(Injustificadas)</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </t>
</templates>
