<odoo>
    <data>
        
        <record id="view_partner_form" model="ir.ui.view">
            <field name="name">res.partner.form.upgrade</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <!-- Con el metodo xpath podemos ser mas detallados a la hora de buscar una locacion 
                en odoo para posicionar nuestros datos propios    -->
                <xpath expr="//field[@name='vat']/.." position="inside">
                    <field name="is_freelance"/>
                </xpath>

                <!-- Este metodo nos permite introducir datos personalizados de manera facil
                pero solo funciona con datos faciles de encontrar ya que al no ser tan especifico como el xpath puede
                ocasionar que falle a la hora de intentar introducir datos a grupos o booknotes especificos -->
                <field name="category_id" position="after">
                    <field name="is_teacher"/>
                </field>
            </field>

        </record>

        <!-- Ejemplo para configurar una vista lista -->
        <record id="teacher_list_view" model="ir.ui.view"> 
            <field name="name">teacher.list.view</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <list>
                        <field name="display_name"/>
                        <field name="phone"/>
                        <field name="email"/>
                </list>
            </field>
        </record>

        <!-- Ejemplo para configurar una vista formulario -->
        <record id="teacher_form_view" model="ir.ui.view">
            <field name="name">teacher.form.view</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Ejemplo para configurar las acciones del menu -->
        <record id="teachers_action" model="ir.actions.act_window">
            <field name="name">Teachers</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field> 

        <!-- La etiqueta view_id y ref sirve para redirigir la accion de una vista principal, por Ejemplo
        si no la usaramos estariamos leyendo la vista de contactos como principal siempre y al usar el ref
        nos redirige a nuestra vista principal, este ejemplo solo sirve para una sola vista. -->
            
            <!-- <field name="view_id" ref="grades_manager.teacher_list_view"/> -->

        <!-- Este ejemplo funciona para dirigir varias vistas -->

            <field name="view_ids"
                        eval="[(5, 0, 0),
                               (0, 0, {'view_mode': 'list', 'view_id': ref('teacher_list_view')}),
                               (0, 0, {'view_mode': 'form', 'view_id': ref('teacher_form_view')})]"/>

        </record>
           
        
    </data>
</odoo>
