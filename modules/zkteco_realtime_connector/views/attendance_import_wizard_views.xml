<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista formulario del wizard de importación -->
        <record id="view_attendance_import_wizard_form" model="ir.ui.view">
            <field name="name">attendance.import.wizard.form</field>
            <field name="model">attendance.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Importar Excel de Checadas">
                    <group>
                        <group>
                            <field name="excel_file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instrucciones">
                            <group>
                                <div style="padding: 10px;">
                                    <h3>Formato del Archivo Excel</h3>
                                    <p>El archivo Excel debe tener las siguientes columnas (sin encabezado o con encabezado en la primera fila):</p>
                                    <p><b>Formatos soportados:</b> .xls (Excel 97-2003) y .xlsx (Excel 2007 o superior)</p>
                                    <ul>
                                        <li><b>Columna A:</b> Número de Empleado</li>
                                        <li><b>Columna B:</b> Nombre del Empleado</li>
                                        <li><b>Columna C:</b> Departamento</li>
                                        <li><b>Columna D:</b> Fecha y Hora de Checada (formato: YYYY-MM-DD HH:MM:SS o DD/MM/YYYY HH:MM:SS)</li>
                                    </ul>
                                    <br/>
                                    <h3>Interpretación de Colores en el Reporte</h3>
                                    <ul>
                                        <li><b style="color: green;">Verde:</b> Más de 8 horas entre primera y última checada del día</li>
                                        <li><b style="color: #FFD700;">Amarillo:</b> Solo una checada o menos de 8 horas entre checadas</li>
                                        <li><b style="color: gray;">Gris (Descanso):</b> Domingos sin checada (excepto guardias de seguridad)</li>
                                        <li><b style="color: #ADD8E6;">Azul claro (Pendiente de comprobar):</b> Días donde otros empleados tienen checadas pero este empleado no</li>
                                    </ul>
                                </div>
                            </group>
                        </page>
                    </notebook>
                    <footer>
                        <button name="action_generate_report" string="Generar Reporte" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Acción para abrir el wizard -->
        <record id="attendance_import_wizard_action" model="ir.actions.act_window">
            <field name="name">Importar Excel de Checadas</field>
            <field name="res_model">attendance.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
