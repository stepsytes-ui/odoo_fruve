<odoo>
    <data noupdate="0">
        <record model="res.groups" id="group_time_off_security">
            <field name="name">Vista de permisos para guardias</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>

        <record model="res.groups" id="group_time_off_security_admin">
            <field name="name">Administrador de guardias</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>

        <record model="ir.rule" id="hr_leave_current_day_security_rule">
            <field name="name">Permisos Aprobados Para Hoy (Seguridad)</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>

            <field name="domain_force">[
                ('state', 'in', ['validate', 'validate1']),
                ('company_id', 'in', company_ids),
                ('holiday_status_id.name', 'in', [
                    'Permiso por horas',
                    'Permiso pagado por horas',
                    'Permiso retardo',
                    'Permiso parcial pagado',
                    'Permiso parcial no pagado'
                ])
            ]</field>

            <field name="groups" eval="[(4, ref('security_view_time_off.group_time_off_security'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_holidays.hr_leave_rule_employee" model="ir.rule">
            <field name="name">Tiempo Personal: Empleados Solo Ven Su Propio</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user')), (3, ref('security_view_time_off.group_time_off_security')), (3, ref('security_view_time_off.group_time_off_security_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record model="ir.rule" id="hr_leave_security_admin_rule">
            <field name="name">Permisos y checadas por rango (Admin guardias)</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="domain_force">[
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('security_view_time_off.group_time_off_security_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>