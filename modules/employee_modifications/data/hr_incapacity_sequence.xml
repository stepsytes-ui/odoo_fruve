<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Secuencia para Incapacidades -->
        <record id="seq_hr_incapacity" model="ir.sequence">
            <field name="name">Secuencia Incapacidades</field>
            <field name="code">hr.incapacity</field>
            <field name="prefix">INCAP/%(y)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="implementation">standard</field>
        </record>
    </data>
</odoo>
