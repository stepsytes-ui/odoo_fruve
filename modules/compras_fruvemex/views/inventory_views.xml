<odoo>
    <data>
        <record id="compras_product_view_list" model="ir.ui.view">
            <field name="name">compras.product.list</field>
            <field name="model">compras.product</field>
            <field name="arch" type="xml">
                <list string="Consolidado">
                    <field name="code" optional="show"/>
                    <field name="name" optional="show"/>
                    <field name="packaging_material_id" optional="show"/>
                    <field name="location" optional="show"/>
                    <field name="model_name" optional="show"/>
                    <field name="serial" optional="show"/>
                    <field name="manufacturer" optional="show"/>
                    <field name="priority" optional="show"/>
                    <field name="classification" optional="show"/>
                    <field name="category_id" optional="show"/>
                    <field name="subcategory_id" optional="show"/>
                    <field name="subcategory_2" optional="show"/>
                    <field name="repair_line_id" optional="show"/>
                    <field name="expiration_date" optional="show"/>
                    <field name="qty_process" optional="show"/>
                    <field name="total_equipment" optional="show"/>
                    <field name="total_qty_process" optional="show"/>
                    <field name="frequency_use_days" optional="show"/>
                    <field name="unit_id" optional="show"/>
                    <field name="unit_price" optional="show"/>
                    <field name="total_cost" optional="show"/>
                    <field name="currency_id" optional="show"/>
                    <field name="coverage_days" optional="show"/>
                    <field name="min_qty" optional="show"/>
                    <field name="max_qty" optional="show"/>
                    <field name="reorder_point" optional="show"/>
                    <field name="lead_time_days" optional="show"/>
                    <field name="purchase_type" optional="show"/>
                    <field name="vendor_id" optional="show"/>
                    <field name="monthly_budget" sum="Total" optional="show"/>
                </list>
            </field>
        </record>

        <record id="compras_product_view_form" model="ir.ui.view">
            <field name="name">compras.product.form</field>
            <field name="model">compras.product</field>
            <field name="arch" type="xml">
                <form string="Consolidado">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                            <h2>
                                <field name="code" readonly="1"/>
                            </h2>
                        </div>
                        <group>
                            <group string="Informacion General">
                                <field name="company_id"/>
                                <field name="code" placeholder="Escanee el codigo aqui"/>
                                <field name="serial"/>
                                <field name="manufacturer"/>
                                <field name="classification"/>
                                <field name="priority"/>
                                <field name="category_id"/>
                                <field name="subcategory_id"/>
                                <field name="subcategory_2"/>
                                <field name="packaging_material_id"/>
                                <field name="repair_line_id"/>
                                <field name="model_name"/>
                                <field name="expiration_date" invisible="not is_chemical_category"/>
                                <field name="unit_id"/>
                                <field name="qty_process"/>
                                <field name="total_equipment"/>
                                <field name="total_qty_process" readonly="1"/>
                                <field name="frequency_use_days"/>
                                <field name="lead_time_days"/>
                                <field name="purchase_type"/>
                                <field name="vendor_id"/>
                                <field name="currency_id"/>
                                <field name="unit_price"/>
                                <field name="total_cost" readonly="1"/>
                                <field name="coverage_days" readonly="1"/>
                                <field name="min_qty"/>
                                <field name="reorder_point" readonly="1"/>
                                <field name="max_qty" readonly="1"/>
                                <field name="monthly_budget" readonly="1"/>
                                <field name="tax_ids" widget="many2many_tags"/>
                            </group>
                            <group string="Código de Barras">
                                <field name="barcode_preview_html" widget="html" nolabel="1" readonly="1"/>
                            </group>
                            <group string="Existencias en Tiempo Real">
                                <field name="inventory_warehouse_id"/>
                                <field name="inventory_location_id" context="{'default_warehouse_id': inventory_warehouse_id}"/>
                                <field name="warehouse_qty_on_hand" readonly="1"/>
                                <field name="warehouse_qty_in" readonly="1"/>
                                <field name="warehouse_qty_out" readonly="1"/>
                                <field name="last_entry_date" readonly="1"/>
                                <field name="last_exit_date" readonly="1"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Bitácora de Movimientos">
                                <field name="move_ids" readonly="1">
                                    <list>
                                        <field name="movement_date"/>
                                        <field name="name"/>
                                        <field name="move_type"/>
                                        <field name="quantity"/>
                                        <field name="quantity_done"/>
                                        <field name="previous_qty"/>
                                        <field name="new_qty"/>
                                        <field name="status"/>
                                        <field name="receiver_name"/>
                                        <field name="registered_by_id"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="compras_product_view_search" model="ir.ui.view">
            <field name="name">compras.product.search</field>
            <field name="model">compras.product</field>
            <field name="arch" type="xml">
                <search string="Buscar Consolidado">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="priority"/>
                    <field name="packaging_material_id"/>
                    <field name="serial"/>
                    <field name="manufacturer"/>
                    <field name="category_id"/>
                    <field name="subcategory_id"/>
                    <field name="vendor_id"/>
                    <group string="Agrupar por" expand="0">
                        <filter name="group_priority" string="Prioridad" context="{'group_by': 'priority'}"/>
                        <filter name="group_packaging_material" string="Material de empaque" context="{'group_by': 'packaging_material_id'}"/>
                        <filter name="group_category" string="Categoria" context="{'group_by': 'category_id'}"/>
                        <filter name="group_subcategory" string="Subcategoria" context="{'group_by': 'subcategory_id'}"/>
                        <filter name="group_vendor" string="Proveedor" context="{'group_by': 'vendor_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="compras_inventory_move_view_list" model="ir.ui.view">
            <field name="name">compras.inventory.move.list</field>
            <field name="model">compras.inventory.move</field>
            <field name="arch" type="xml">
                <list string="Bitácora de Movimientos">
                    <field name="movement_date"/>
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="move_type"/>
                    <field name="source_warehouse_id"/>
                    <field name="destination_warehouse_id"/>
                    <field name="area_id"/>
                    <field name="location_id"/>
                    <field name="quantity"/>
                    <field name="quantity_done"/>
                    <field name="previous_qty"/>
                    <field name="new_qty"/>
                    <field name="status"/>
                    <field name="receiver_user_id"/>
                    <field name="receiver_name"/>
                    <field name="delivered_by_id"/>
                    <field name="signed_by_id"/>
                    <field name="registered_by_id"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="compras_inventory_move_view_form" model="ir.ui.view">
            <field name="name">compras.inventory.move.form</field>
            <field name="model">compras.inventory.move</field>
            <field name="arch" type="xml">
                <form string="Movimiento de Almacén">
                    <header>
                        <button name="action_confirm" string="Confirmar" type="object" class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_cancel" string="Cancelar" type="object" class="btn-secondary" invisible="state == 'cancelled'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,done,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Movimiento">
                                <field name="company_id"/>
                                <field name="movement_date"/>
                                <field name="move_type"/>
                                <field name="product_id"/>
                                <field name="unit_id" readonly="1"/>
                                <field name="source_warehouse_id"/>
                                <field name="destination_warehouse_id"/>
                            </group>
                            <group string="Control">
                                <field name="quantity"/>
                                <field name="quantity_done"/>
                                <field name="status"/>
                                <field name="area_id"/>
                                <field name="location_id"/>
                                <field name="destination" invisible="1"/>
                                <field name="receiver_user_id"/>
                                <field name="receiver_name"/>
                                <field name="delivered_by_id"/>
                                <field name="signed_by_id"/>
                                <field name="registered_by_id" readonly="1"/>
                            </group>
                        </group>
                        <group string="Existencias">
                            <field name="previous_qty" readonly="1"/>
                            <field name="new_qty" readonly="1"/>
                            <field name="request_id" readonly="1"/>
                        </group>
                        <group string="Observaciones">
                            <field name="notes" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="compras_inventory_move_view_search" model="ir.ui.view">
            <field name="name">compras.inventory.move.search</field>
            <field name="model">compras.inventory.move</field>
            <field name="arch" type="xml">
                <search string="Buscar Movimientos">
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="receiver_name"/>
                    <field name="receiver_user_id"/>
                    <field name="source_warehouse_id"/>
                    <field name="destination_warehouse_id"/>
                    <field name="location_id"/>
                    <filter name="entries" string="Entradas" domain="[('move_type', '=', 'entrada')]"/>
                    <filter name="exits" string="Salidas" domain="[('move_type', '=', 'salida')]"/>
                    <filter name="transfers" string="Transferencias" domain="[('move_type', '=', 'transferencia')]"/>
                    <filter name="shortages" string="Faltantes" domain="[('move_type', '=', 'entrada'), ('status', 'in', ['faltante', 'incompleto', 'defectuoso'])]"/>
                    <filter name="done" string="Confirmados" domain="[('state', '=', 'done')]"/>
                    <filter name="today" string="Hoy" domain="[('movement_date', '&gt;=', context_today())]"/>
                    <group string="Agrupar por" expand="0">
                        <filter name="group_type" string="Tipo" context="{'group_by': 'move_type'}"/>
                        <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                        <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                        <filter name="group_source" string="Almacén Origen" context="{'group_by': 'source_warehouse_id'}"/>
                        <filter name="group_destination" string="Almacén Destino" context="{'group_by': 'destination_warehouse_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="compras_warehouse_view_list" model="ir.ui.view">
            <field name="name">compras.warehouse.list</field>
            <field name="model">compras.warehouse</field>
            <field name="arch" type="xml">
                <list string="Almacenes">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="company_id"/>
                    <field name="is_main"/>
                    <field name="movement_count"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="compras_warehouse_view_form" model="ir.ui.view">
            <field name="name">compras.warehouse.form</field>
            <field name="model">compras.warehouse</field>
            <field name="arch" type="xml">
                <form string="Almacén">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button
                                type="object"
                                name="action_open_inventory"
                                class="oe_stat_button"
                                icon="fa-cubes"
                            >
                                <field name="inventory_line_count" string="Inventario" widget="statinfo"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="company_id"/>
                                <field name="code"/>
                                <field name="is_main"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="movement_count" readonly="1"/>
                            </group>
                        </group>
                        <group string="Observaciones">
                            <field name="notes" nolabel="1"/>
                        </group>
                        <notebook>
                            <page string="Movimientos de Entrada">
                                <field name="destination_move_ids" readonly="1">
                                    <list>
                                        <field name="movement_date"/>
                                        <field name="product_id"/>
                                        <field name="location_id"/>
                                        <field name="quantity_done"/>
                                        <field name="status"/>
                                        <field name="receiver_user_id"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Movimientos de Salida">
                                <field name="source_move_ids" readonly="1">
                                    <list>
                                        <field name="movement_date"/>
                                        <field name="product_id"/>
                                        <field name="location_id"/>
                                        <field name="quantity_done"/>
                                        <field name="status"/>
                                        <field name="receiver_user_id"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Locaciones">
                                <field name="location_ids" context="{'default_warehouse_id': id}">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="company_id" readonly="1"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="compras_warehouse_view_search" model="ir.ui.view">
            <field name="name">compras.warehouse.search</field>
            <field name="model">compras.warehouse</field>
            <field name="arch" type="xml">
                <search string="Buscar Almacenes">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="company_id"/>
                    <filter name="main" string="Principales" domain="[('is_main', '=', True)]"/>
                    <filter name="active" string="Activos" domain="[('active', '=', True)]"/>
                </search>
            </field>
        </record>

        <record id="compras_warehouse_inventory_view_list" model="ir.ui.view">
            <field name="name">compras.warehouse.inventory.list</field>
            <field name="model">compras.warehouse.inventory</field>
            <field name="arch" type="xml">
                <list string="Inventario por Almacén" create="0" edit="0" delete="0">
                    <field name="product_db_id"/>
                    <field name="product_name"/>
                    <field name="product_description"/>
                    <field name="quantity"/>
                    <field name="location"/>
                </list>
            </field>
        </record>

        <record id="compras_warehouse_inventory_view_search" model="ir.ui.view">
            <field name="name">compras.warehouse.inventory.search</field>
            <field name="model">compras.warehouse.inventory</field>
            <field name="arch" type="xml">
                <search string="Buscar Inventario por Almacén">
                    <field name="warehouse_id"/>
                    <field name="product_name"/>
                    <field name="location"/>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_warehouse" string="Almacén" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_company" string="Empresa" context="{'group_by': 'company_id'}"/>
                </search>
            </field>
        </record>

        <record id="compras_product_action" model="ir.actions.act_window">
            <field name="name">Consolidado</field>
            <field name="res_model">compras.product</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="compras_inventory_move_action" model="ir.actions.act_window">
            <field name="name">Bitácora de Movimientos</field>
            <field name="res_model">compras.inventory.move</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="compras_inventory_exit_action" model="ir.actions.act_window">
            <field name="name">Salidas de Almacén</field>
            <field name="res_model">compras.inventory.move</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('move_type', 'in', ['salida', 'transferencia'])]</field>
            <field name="context">{'default_move_type': 'salida'}</field>
        </record>

        <record id="compras_shortage_report_action" model="ir.actions.act_window">
            <field name="name">Reporte de Faltantes</field>
            <field name="res_model">compras.inventory.move</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('move_type', '=', 'entrada'), ('status', 'in', ['faltante', 'incompleto'])]</field>
        </record>

        <record id="compras_warehouse_action" model="ir.actions.act_window">
            <field name="name">Almacenes</field>
            <field name="res_model">compras.warehouse</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="compras_warehouse_inventory_action" model="ir.actions.act_window">
            <field name="name">Inventario</field>
            <field name="res_model">compras.warehouse.inventory</field>
            <field name="view_mode">list</field>
            <field name="context">{'search_default_group_product': 0}</field>
        </record>

        <record id="compras_packaging_material_action" model="ir.actions.act_window">
            <field name="name">Materiales de empaque</field>
            <field name="res_model">compras.packaging.material</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="compras_warehouse_inventory_remove_selected_server_action" model="ir.actions.server">
            <field name="name">Eliminar del inventario</field>
            <field name="model_id" ref="model_compras_warehouse_inventory"/>
            <field name="binding_model_id" ref="model_compras_warehouse_inventory"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
action = records.action_remove_selected_inventory()
            </field>
        </record>
    </data>
</odoo>
