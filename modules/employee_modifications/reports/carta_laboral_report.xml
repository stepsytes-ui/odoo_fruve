<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_carta_laboral" model="report.paperformat">
        <field name="name">Carta Laboral A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">13</field>
        <field name="margin_left">13</field>
        <field name="margin_right">13</field>
        <field name="header_spacing">8</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
    </record>

    <!-- Definición del reporte -->
    <record id="report_carta_laboral" model="ir.actions.report">
        <field name="name">Carta Laboral</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">employee_modifications.carta_laboral_template</field>
        <field name="report_file">employee_modifications.carta_laboral_template</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Carta_Laboral_%s' % (object.name)</field>
        <field name="paperformat_id" ref="employee_modifications.paperformat_carta_laboral"/>
    </record>

    <!-- Template QWeb -->
    <template id="carta_laboral_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="employee">
                <t t-set="company" t-value="employee.company_id"/>
                <t t-call="web.external_layout_bold">
                        <style>
                            .carta-laboral {
                                font-family: Arial, sans-serif;
                                font-size: 12pt;
                                padding-top: 16mm;
                                box-sizing: border-box;
                                text-rendering: optimizeLegibility;
                            }
                            .carta-laboral strong {
                                font-weight: bold;
                                white-space: normal;
                            }
                        
                            .footer, footer, #footer,
                            .o_report_layout_standard .footer,
                            .article + .footer {
                                display: none !important;
                            }
                        </style>
                    <div class="page carta-laboral">
                        
                        <!-- Encabezado con ubicación y fecha -->
                        <t t-set="meses" t-value="{'1': 'ENERO', '2': 'FEBRERO', '3': 'MARZO', '4': 'ABRIL', '5': 'MAYO', '6': 'JUNIO', '7': 'JULIO', '8': 'AGOSTO', '9': 'SEPTIEMBRE', '10': 'OCTUBRE', '11': 'NOVIEMBRE', '12': 'DICIEMBRE'}"/>
                        <t t-set="hoy" t-value="context_timestamp(datetime.datetime.now())"/>
                        <t t-set="dia" t-value="hoy.strftime('%d')"/>
                        <t t-set="mes" t-value="meses[hoy.strftime('%m').lstrip('0')]"/>
                        <t t-set="anio" t-value="hoy.strftime('%Y')"/>
                        
                        <div style="text-align: right; margin-top: 8px; margin-bottom: 32px;">
                            <span t-esc="company.get_carta_laboral_location()"/>, A <t t-esc="dia"/> DE <t t-esc="mes"/> DE <t t-esc="anio"/>
                        </div>

                        <!-- Título -->
                        <div style="text-align: left; margin-bottom: 24px; font-weight: bold;">
                            <p>A QUIEN CORRESPONDA:</p>
                        </div>

                        <!-- Cuerpo del documento -->
                        <div style="text-align: justify; line-height: 1.45; margin-bottom: 36px;">
                            <p style="text-align: justify; line-height: 1.45; word-spacing: normal; text-align-last: left;">
                                Por medio de la presente hacemos constar que el/la C. <strong><t t-esc="employee.name.upper()"/></strong> labora en esta empresa denominada <strong><t t-esc="company.get_carta_laboral_name()"/></strong> con domicilio en 
                                <span t-if="employee.company_id.partner_id.street">
                                    <t t-esc="employee.company_id.partner_id.street"/><t t-if="employee.company_id.partner_id.street2">, <t t-esc="employee.company_id.partner_id.street2"/></t><t t-if="employee.company_id.partner_id.city">, <t t-esc="employee.company_id.partner_id.city"/></t><t t-if="employee.company_id.partner_id.state_id">, <t t-esc="employee.company_id.partner_id.state_id.name"/></t><t t-if="employee.company_id.partner_id.zip">, C.P. <t t-esc="employee.company_id.partner_id.zip"/></t>
                                </span> desde el día <strong><t t-esc="employee.get_fecha_ingreso_formatted()"/></strong>. Desempeñando el puesto de 
                                <t t-if="employee.job_id">
                                    <strong><t t-esc="employee.job_id.name.upper()"/></strong>
                                </t>
                                <t t-else="">
                                    <strong>SIN PUESTO ASIGNADO</strong>
                                </t> 
                                con un horario hasta el día de hoy de <strong><t t-esc="employee.get_horario_trabajo().upper()"/></strong>, percibiendo ingresos mensuales de $ <strong><t t-esc="employee.get_salario_mensual_formatted()"/></strong> (<strong><t t-esc="employee.get_salario_mensual_letras()"/></strong>)
                                <t t-if="employee.rfc">, Registro Federal de Contribuyentes es: <strong><t t-esc="employee.rfc.upper()"/></strong></t>
                                <t t-if="employee.ssnid"> con número de IMSS <strong><t t-esc="employee.ssnid"/></strong></t>
                                <t t-if="employee.company_id.partner_id.company_registry"> el Registro Patronal de la empresa es <strong><t t-esc="employee.company_id.partner_id.company_registry"/></strong></t>
                                <t t-if="employee.company_id.partner_id.vat"> y el Registro Federal de Contribuyente es <strong><t t-esc="employee.company_id.partner_id.vat"/></strong></t>.
                            </p>
                            <p style="margin-top: 10px;">
                                Se extiende la presente carta de trabajo para los fines que el interesado considere convenientes.
                            </p>
                        </div>

                        <!-- Firma -->
                        <div style="text-align: center; margin-top: 44px;">
                            <p style="font-weight: bold;">ATENTAMENTE:</p>
                            <div style="margin-top: 34px;">
                                <p>____________________________________</p>
                                <p style="font-weight: bold; margin-top: 5px;" t-esc="company.get_carta_laboral_responsable_rh()"/>
                                <p style="font-weight: bold;">RECURSOS HUMANOS</p>
                                <p style="font-weight: bold;" t-esc="company.get_carta_laboral_name()"/>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
