<odoo>
  <record id="hr_leave_security_list_view" model="ir.ui.view">
    <field name="name">hr.leave.security.list</field>
    <field name="model">hr.leave</field>
    <field name="arch" type="xml">
      <list>
        <field name="employee_image" widget="image" class="oe_avatar" options="{'size': [0, 100]}"/>
        <field name="biometric_id"/>
        <field name="employee_id"/>
        <field name="holiday_status_id" string="Tipo de Ausencia"/>
        <field name="request_datetime_from" string="Fecha Inicio"/>
        <field name="request_datetime_to" string="Fecha Fin"/>
        <field name="display_duration" string="Duración"/>
        <field name="check_in_time" string="Entrada" />
        <field name="check_out_time" string="Salida" />
        <field name="state"/>
        <button name="action_check_in" type="object" string="Checar Entrada" class="btn-primary" icon="fa-sign-in"/>
        <button name="action_check_out" type="object" string="Checar Salida" class="btn-warning" icon="fa-sign-out"/>
      </list>
    </field>
  </record>

  <!-- Vista de Búsqueda con Filtros por Fecha -->
  <record id="hr_leave_security_search_view" model="ir.ui.view">
    <field name="name">hr.leave.security.search</field>
    <field name="model">hr.leave</field>
    <field name="arch" type="xml">
      <search>
        <!-- Campo para seleccionar la fecha a buscar -->
        <field name="request_date_from" string="Fecha de Inicio del Permiso"/>
        <field name="request_date_to" string="Fecha de Fin del Permiso"/>
        <field name="employee_id" string="Empleado"/>
        <field name="holiday_status_id" string="Tipo de Ausencia"/>
        
        <filter name="today_filter" string="Hoy" domain="[('request_date_from', '&lt;=', context_today()), ('request_date_to', '&gt;=', context_today())]"/>
        
        <separator/>
        
        <!-- Agrupación -->
        <group expand="0" string="Agrupar Por">
          <filter name="group_by_employee" string="Empleado" context="{'group_by': 'employee_id'}"/>
          <filter name="group_by_date" string="Fecha de Inicio" context="{'group_by': 'request_date_from'}"/>
          <filter name="group_by_type" string="Tipo de Ausencia" context="{'group_by': 'holiday_status_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="hr_leave_security_admin_list_view" model="ir.ui.view">
    <field name="name">hr.leave.security.admin.list</field>
    <field name="model">hr.leave</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="employee_image" widget="image" class="oe_avatar" options="{'size': [0, 100]}"/>
        <field name="biometric_id"/>
        <field name="employee_id"/>
        <field name="holiday_status_id" string="Tipo de Ausencia"/>
        <field name="request_datetime_from" string="Fecha Inicio"/>
        <field name="request_datetime_to" string="Fecha Fin"/>
        <field name="display_duration" string="Duracion"/>
        <field name="check_in_time" string="Entrada"/>
        <field name="check_out_time" string="Salida"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <record id="hr_leave_security_admin_search_view" model="ir.ui.view">
    <field name="name">hr.leave.security.admin.search</field>
    <field name="model">hr.leave</field>
    <field name="arch" type="xml">
      <search>
        <field name="employee_id" string="Empleado"/>
        <field name="holiday_status_id" string="Tipo de Ausencia"/>
        <field name="request_date_from" string="Fecha Inicio Permiso"/>
        <field name="request_date_to" string="Fecha Fin Permiso"/>
        <field name="check_in_time" string="Checada Entrada"/>
        <field name="check_out_time" string="Checada Salida"/>

        <filter name="with_checks" string="Con Checadas" domain="['|', ('check_in_time', '!=', False), ('check_out_time', '!=', False)]"/>

        <separator/>

        <group expand="0" string="Agrupar Por">
          <filter name="group_by_employee_admin" string="Empleado" context="{'group_by': 'employee_id'}"/>
          <filter name="group_by_type_admin" string="Tipo de Ausencia" context="{'group_by': 'holiday_status_id'}"/>
          <filter name="group_by_day_check_in_admin" string="Dia Entrada" context="{'group_by': 'check_in_time:day'}"/>
          <filter name="group_by_day_check_out_admin" string="Dia Salida" context="{'group_by': 'check_out_time:day'}"/>
        </group>
      </search>
    </field>
  </record>
</odoo>
