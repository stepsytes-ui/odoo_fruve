<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_tax_option_tree" model="ir.ui.view">
        <field name="name">customer.tax.option.tree</field>
        <field name="model">customer.tax.option</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="percent" widget="percentage"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_customer_tax_option_form" model="ir.ui.view">
        <field name="name">customer.tax.option.form</field>
        <field name="model">customer.tax.option</field>
        <field name="arch" type="xml">
            <form string="Opcion de impuesto">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="percent" widget="percentage"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_customer_tax_option" model="ir.actions.act_window">
        <field name="name">Opciones de impuesto</field>
        <field name="res_model">customer.tax.option</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_customer_tools_root"
              name="Herramientas Polair"
              parent="sale.menu_sales_config"
              sequence="95"
              groups="sales_team.group_sale_manager,account.group_account_manager,account.group_account_invoice,base.group_system"/>

    <menuitem id="menu_customer_tax_option"
              name="Opciones de impuesto"
              parent="menu_customer_tools_root"
              action="action_customer_tax_option"
              sequence="20"
              groups="sales_team.group_sale_manager,account.group_account_manager,account.group_account_invoice,base.group_system"/>
</odoo>
