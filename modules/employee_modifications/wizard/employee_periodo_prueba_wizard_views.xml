<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_periodo_prueba_wizard_form" model="ir.ui.view">
            <field name="name">employee.periodo.prueba.wizard.form</field>
            <field name="model">employee.periodo.prueba.wizard</field>
            <field name="arch" type="xml">
                <form string="Resolver Periodo de Prueba">
                    <sheet>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="decision" widget="radio"/>
                            <field name="motivo_no_renovacion"
                                   invisible="decision != 'no_renovacion'"
                                   required="decision == 'no_renovacion'"
                                   placeholder="Indique la razón de la no renovación..."/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm" string="Confirmar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
