<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron para recalcular vacaciones anualmente -->
        <record id="ir_cron_recalcular_vacaciones" model="ir.cron">
            <field name="name">Recalcular Vacaciones Anuales</field>
            <field name="model_id" ref="model_employee_expedient"/>
            <field name="state">code</field>
            <field name="code">model._cron_recalcular_vacaciones_anuales()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
