<odoo>
  <record id="hr_leave_security_list_view" model="ir.ui.view">
    <field name="name">hr.leave.security.list</field>
    <field name="model">hr.leave</field>
    <field name="arch" type="xml">
      <list>
        <field name="biometric_id"/>
        <field name="employee_id"/>
        <field name="holiday_status_id" string="Tipo de Ausencia"/>
        <field name="request_date_from" string="Fecha Inicio"/>
        <field name="request_date_to" string="Fecha Fin"/>
        <field name="number_of_days" string="Días"/>
        <field name="state"/>
      </list>
    </field>
  </record>
</odoo>
