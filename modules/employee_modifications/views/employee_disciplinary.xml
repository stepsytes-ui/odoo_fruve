<odoo>
    <data>
        <record id="view_employee_disciplinary_record_form" model="ir.ui.view">
            <field name="name">employee.disciplinary.record.form</field>
            <field name="model">employee.disciplinary.record</field>
            <field name="arch" type="xml">
                <form string="Acta Disciplinaria">
                    <sheet>
                        <group>
                            <field name="employee_id"/>
                            <field name="fecha_acta"/>
                            <field name="motivo"/>
                            <field name="acta_disciplinaria_file" filename="nombre_archivo"/>
                            <field name="nombre_archivo" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="action_employee_disciplinary_record" model="ir.actions.act_window">
            <field name="name">Actas Disciplinarias</field>
            <field name="res_model">employee.disciplinary.record</field>
            <field name="view_mode">list,form</field>
        </record>
        
    </data>
</odoo>