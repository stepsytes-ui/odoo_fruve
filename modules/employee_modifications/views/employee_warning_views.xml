<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Lista (list) de Amonestaciones -->
    <record id="view_employee_warning_list" model="ir.ui.view">
        <field name="name">employee.warning.list</field>
        <field name="model">employee.warning</field>
        <field name="arch" type="xml">
            <list string="Amonestaciones">
                <field name="name" string="Folio"/>
                <field name="warning_date" string="Fecha"/>
                <field name="biometric_id" string="Número de Empleado"/>
                <field name="employee_name" string="Nombre"/>
                <field name="department_id" string="Departamento"/>
                <field name="turno_id" string="Turno"/>
                <field name="supervisor_id" string="Supervisor"/>
                <field name="registered_by_id" string="Registrado por"/>
            </list>
        </field>
    </record>

    <!-- Vista de Formulario de Amonestaciones -->
    <record id="view_employee_warning_form" model="ir.ui.view">
        <field name="name">employee.warning.form</field>
        <field name="model">employee.warning</field>
        <field name="arch" type="xml">
            <form string="Amonestación">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="warning_date" string="Fecha"/>
                            <field name="registered_by_id" string="Registra" readonly="1"/>
                            <field name="employee_id" string="Amonestado" 
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="biometric_id" string="Número de Empleado"/>
                            <field name="employee_name" string="Nombre"/>
                        </group>
                        <group>
                            <field name="department_id" string="Departamento"/>
                            <field name="turno_id" string="Turno"/>
                            <field name="supervisor_id" string="Supervisor" 
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detalles de la Amonestación">
                            <group>
                                <field name="causa" string="Causa" 
                                       placeholder="Describa la razón de la amonestación..."/>
                            </group>
                            <group>
                                <field name="supervisor_comments" string="Comentarios del Supervisor"
                                       placeholder="Comentarios adicionales del supervisor..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de Búsqueda de Amonestaciones -->
    <record id="view_employee_warning_search" model="ir.ui.view">
        <field name="name">employee.warning.search</field>
        <field name="model">employee.warning</field>
        <field name="arch" type="xml">
            <search string="Buscar Amonestaciones">
                <field name="name" string="Folio"/>
                <field name="biometric_id" string="Número de Empleado"
                       filter_domain="[('biometric_id', 'ilike', self)]"/>
                <field name="employee_name" string="Nombre Empleado"
                       filter_domain="[('employee_name', 'ilike', self)]"/>
                <field name="department_id" string="Departamento"/>
                <field name="supervisor_id" string="Supervisor"/>
                <separator/>
                <filter string="Este Mes" name="this_month"
                        domain="[('warning_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('warning_date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <filter string="Este Año" name="this_year"
                        domain="[('warning_date', '&gt;=', (context_today() - relativedelta(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Departamento" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Supervisor" name="group_supervisor" context="{'group_by': 'supervisor_id'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'warning_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana para Amonestaciones -->
    <record id="action_employee_warning" model="ir.actions.act_window">
        <field name="name">Amonestaciones</field>
        <field name="res_model">employee.warning</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva amonestación
            </p>
            <p>
                Registre las amonestaciones de los empleados con toda la información necesaria.
            </p>
        </field>
    </record>

</odoo>
