<odoo>
    <data noupdate="0">
        <record id="group_hr_manager_custom" model="res.groups">
            <field name="name">Recursos Humanos</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_attendance_report_user" model="res.groups">
            <field name="name">Usuario de Reportes de Asistencia</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_hr_recruiting_custom_access" model="res.groups">
            <field name="name">Acceso a Empleados (Custom)</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/> 
        </record>
        
        <record id="group_hr_time_off_custom_access" model="res.groups">
            <field name="name">Acceso a Tiempo Personal (Custom)</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('hr_holidays.group_hr_holidays_manager'))]"/>
        </record>
        
        <record id="group_hr_attendance_custom_access" model="res.groups">
            <field name="name">Acceso a Asistencias (Custom)</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
        </record>

        <record id="group_rh_absence_manager" model="res.groups">
            <field name="name">RH Absence Manager</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <function model="res.groups" name="write">
            <value eval="[ref('group_hr_manager_custom')]"/>
            <value eval="{'implied_ids': [(4, ref('group_hr_recruiting_custom_access')), 
                                          (4, ref('group_hr_time_off_custom_access')), 
                                          (4, ref('group_hr_attendance_custom_access')),
                                          (4, ref('group_attendance_report_user'))]}"/>
        </function>

    </data>
</odoo>