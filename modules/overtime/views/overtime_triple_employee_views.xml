<odoo>
    <data>
        <record id="overtime_triple_employee_view_list" model="ir.ui.view">
            <field name="name">overtime.triple.employee.list</field>
            <field name="model">overtime.triple.employee</field>
            <field name="arch" type="xml">
                <list string="Empleados con Hora Triple" editable="bottom">
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="employee_id"/>
                    <field name="active"/>
                    <field name="note"/>
                </list>
            </field>
        </record>

        <record id="overtime_triple_employee_view_form" model="ir.ui.view">
            <field name="name">overtime.triple.employee.form</field>
            <field name="model">overtime.triple.employee</field>
            <field name="arch" type="xml">
                <form string="Empleado con Hora Triple">
                    <sheet>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="employee_id"/>
                            <field name="active"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="overtime_triple_employee_action" model="ir.actions.act_window">
            <field name="name">Empleados Hora Triple</field>
            <field name="res_model">overtime.triple.employee</field>
            <field name="view_mode">list,form</field>
            <field name="groups_id" eval="[(4, ref('overtime.group_overtime_hr'))]"/>
        </record>
    </data>
</odoo>
