<odoo>
    <data noupdate="1">
        <record id="sequence_purchase_request" model="ir.sequence">
            <field name="name">Solicitud de Compra</field>
            <field name="code">purchase.request</field>
            <field name="prefix">PC/%(y)s/%(month)s/</field>
            <field name="padding">4</field>
        </record>

        <record id="sequence_compras_product" model="ir.sequence">
            <field name="name">Producto de Almacén</field>
            <field name="code">compras.product</field>
            <field name="prefix">PROD/%(y)s/</field>
            <field name="padding">4</field>
        </record>

        <record id="sequence_compras_inventory_move" model="ir.sequence">
            <field name="name">Movimiento de Almacén</field>
            <field name="code">compras.inventory.move</field>
            <field name="prefix">MOV/%(y)s/%(month)s/</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
