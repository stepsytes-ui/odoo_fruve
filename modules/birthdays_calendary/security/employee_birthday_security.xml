<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Regla de seguridad para restringir los cumpleaños por empresas permitidas del usuario -->
    <record id="employee_birthday_company_rule" model="ir.rule">
        <field name="name">Employee Birthday - User Companies</field>
        <field name="model_id" ref="model_employee_birthday"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="global" eval="True"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
