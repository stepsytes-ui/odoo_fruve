<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="overtime.OvertimeDashboard" owl="1">
    <div class="o_overtime_dashboard container-fluid p-3 bg-light" style="marging-bottom: 16px; border-radius: 8px;">

        <div t-if="state.loading" class="text-center">
            <i class="fa fa-spinner fa-spin fa-2x text-primary"/>
            <p class="mt-2">Cargando datos de tiempo extra...</p>
        </div>

        <div t-if="!state.loading">
            <div class="row mb-3 align-items-center">
                <div class="col-md-6">
                    <h4 class="fw-bold mb-0">Dashboard de Tiempo Extra </h4>
                </div>
                <div class="col-md-6 text_end d-flex align-items-center justify-content-end gap-2">
                    <label class="fw-bold small me-2">Desde:</label>
                    <input type="date" t-model="state.start_date" class="form-control form-control-sm w-auto"/>
                    
                    <label class="fw-bold small ms-2 me-2">Hasta:</label>
                    <input type="date" t-model="state.end_date" class="form-control form-control-sm w-auto"/>

                    <button class="btn btn-sm btn-primary ms-2" t-on-click="_onRefresh" title="Refrescar">
                        <i class="fa fa-refresh"/>
                    </button>
                </div>
            </div>

            <!-- Tabla de detalles de empleados -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0 text-white">Detalles de Tiempo Extra por Empleado</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover table-striped mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="text-center" style="width: 10%;">No. Empleado</th>
                                            <th class="text-center" style="width: 15%;">Nombre</th>
                                            <th class="text-right" style="width: 12%;">Salario Diario</th>
                                            <th class="text-center" style="width: 10%;">DTC Tiempo Extra</th>
                                            <th class="text-center" style="width: 12%;">Horas Extras Totales</th>
                                            <th class="text-right" style="width: 15%;">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.tableData" t-as="row" t-key="row.employee_number">
                                            <td class="text-center">
                                                <t t-esc="row.employee_number"/>
                                            </td>
                                            <td class="text-left">
                                                <t t-esc="row.employee_name"/>
                                            </td>
                                            <td class="text-right">
                                                $<t t-esc="(row.daily_rate || 0).toFixed(2)"/>
                                            </td>
                                            <td class="text-center">
                                                <t t-esc="row.days_worked"/>
                                            </td>
                                            <td class="text-center">
                                                <t t-esc="(row.hours_taken || 0).toFixed(2)"/>h
                                            </td>
                                            <td class="text-right fw-bold text-success">
                                                $<t t-esc="(row.total || 0).toFixed(2)"/>
                                            </td>
                                        </tr>
                                        <tr t-if="!state.tableData || state.tableData.length === 0">
                                            <td colspan="6" class="text-center text-muted p-4">
                                                No hay datos de tiempo extra para el período seleccionado
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </t>
</templates>
