<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Regla multi-empresa: solo se ven registros de las compañías seleccionadas -->
        <record id="enfermeria_accidente_company_rule" model="ir.rule">
            <field name="name">Enfermería Accidente/Incidente Multi-Company Rule</field>
            <field name="model_id" ref="model_enfermeria_accidente"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
