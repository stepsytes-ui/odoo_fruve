<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Regla multi-empresa para overtime -->
        <record id="overtime_company_rule" model="ir.rule">
            <field name="name">Overtime Multi-Company Rule</field>
            <field name="model_id" ref="model_overtime"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Regla multi-empresa para overtime.employee.line -->
        <record id="overtime_employee_line_company_rule" model="ir.rule">
            <field name="name">Overtime Employee Line Multi-Company Rule</field>
            <field name="model_id" ref="model_overtime_employee_line"/>
            <field name="domain_force">[('overtime_id.company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Regla multi-empresa para overtime.triple.employee -->
        <record id="overtime_triple_employee_company_rule" model="ir.rule">
            <field name="name">Overtime Triple Employee Multi-Company Rule</field>
            <field name="model_id" ref="model_overtime_triple_employee"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
