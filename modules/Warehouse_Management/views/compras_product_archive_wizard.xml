<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="compras_product_archive_wizard_form" model="ir.ui.view">
        <field name="name">compras.product.archive.wizard.form</field>
        <field name="model">compras.product.archive.wizard</field>
        <field name="arch" type="xml">
            <form string="Eliminar producto del consolidado">
                <div class="alert alert-warning" role="alert">
                    El producto se archivará y dejará de aparecer en el consolidado. Se generarán movimientos de eliminación para dar de baja todas sus existencias positivas en cada almacén. Esta acción no se puede deshacer desde esta pantalla; el historial de movimientos se conservará.
                </div>
                <group>
                    <field name="product_id"/>
                    <field name="total_stock"/>
                    <field name="stock_summary" nolabel="1"/>
                    <field name="deletion_context" placeholder="Describe por qué solicitas eliminar este producto..."/>
                    <field name="confirm_deletion"/>
                </group>
                <footer>
                    <button string="Confirmar eliminación" type="object" name="action_confirm_deletion" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>