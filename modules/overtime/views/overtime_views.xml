<odoo>
    <data>
        <record id="overtime_request_view_form" model="ir.ui.view">
            <field name="name">overtime.form</field>
            <field name="model">overtime</field>
            <field name="arch" type="xml">
                <form string="Solicitud de Tiempo Extra">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,rejected"/>
                        <button name="action_submit_and_split" 
                                type="object" 
                                string="Enviar Solicitud" 
                                class="oe_highlight"
                                invisible="state != 'draft'"
                                groups="overtime.group_overtime_supervisor,overtime.group_overtime_hr"
                        />
                        <button name="action_approve"
                                type="object"
                                string="Aprobar"
                                class="oe_highlight"
                            invisible="state not in ('pending', 'rejected')"
                                groups="overtime.group_overtime_hr"
                        />
                        <button name="action_reject"
                                type="object"
                                string="Rechazar"
                                class="btn-secondary"
                            invisible="state not in ('pending', 'approved')"
                                groups="overtime.group_overtime_hr"
                        />
                        </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>

                        <group>
                            <group string="Información General">
                                <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                                <field name="department_id"/>
                                <field name="area_id"/>
                                <field name="supervisor_id"/>
                            </group>
                            <group string="Detalles">
                                <field name="requested_date" string="Fecha solicitada"/>
                                <field name="create_date" string="Fecha de elaboración" readonly="1"/>
                                <field name="authorized_by_id" invisible="state in ('draft', 'pending')" />
                                <field name="rejection_reason" invisible="state != 'rejected'" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <separator string="Horas Solicitadas" invisible="state == 'draft'"/>
                                    <field name="time_from" widget="float_time" invisible="state == 'draft'"/>
                                    <field name="time_to" widget="float_time" invisible="state == 'draft'"/>
                                    <field name="hours_taken" invisible="state == 'draft'"/> 
                            </group>
                            <group>
                                <separator string="Explicación"/>
                                <field name="justification" nolabel="1"/>
                            </group>
                        </group>

                        <group>
                                <group>
                                    <separator string="Datos del empleado" invisible="state == 'draft'"/>
                                    <field name="biometric_id" invisible="state == 'draft'"/>
                                    <field name="employee_id" invisible="state == 'draft'"/>
                                    <field name="activity" invisible="state == 'draft'"/> 
                                </group>
                                <group>
                                    <separator string="Información de asistencia" invisible="state == 'draft'"/>
                                    <field name="attendance_log" nolabel="1" invisible="state == 'draft'"/>
                                </group>
                        </group>

                        <group invisible="state != 'draft' or not department_id or not area_id or not requested_date or not justification">
                            <separator string="Datos de Empleado/s (Captura Múltiple)"/>
                            <field name="employee_line_ids">
                                <list editable="bottom">
                                    <field name="biometric_id"/>
                                    <field name="employee_id"/> 
                                    <field name="time_from" widget="float_time"/>
                                    <field name="time_to" widget="float_time"/>
                                    <field name="hours_taken"/> 
                                    <field name="activity"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="overtime_request_view_list" model="ir.ui.view">
            <field name="name">overtime.list</field>
            <field name="model">overtime</field>
            <field name="arch" type="xml">
                <list string="Solicitudes de Tiempo Extra">
                    <field name="company_id" column_invisible="True"/>
                    <field name="name"/>
                    <field name="requested_date" width="120"/>
                    <field name="department_id"/>
                    <field name="area_id"/>
                    <field name="supervisor_id"/>
                    <field name="justification"/>
                    <field name="biometric_id"  width="140"/>
                    <field name="employee_id"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>


        <record id="overtime_request_action" model="ir.actions.act_window">
            <field name="name">Solicitudes de Tiempo Extra</field>
            <field name="res_model">overtime</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state', 'in', ['draft', 'pending','rejected'])]</field>
            <field name="context">{'search_default_requested_date_filter': 1, 'search_default_my_requests': 1}</field>
            <field name="groups_id" eval="[(4, ref('overtime.group_overtime_supervisor')), (4, ref('overtime.group_overtime_hr'))]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face" style="margin-top: 60px;">
                    Crea tu primera solicitud de tiempo extra
                </p>
            </field>
        </record>

        <record id="overtime_request_approved_action" model="ir.actions.act_window">
            <field name="name">Tiempo Extra Autorizado</field>
            <field name="res_model">overtime</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state', '=', 'approved')]</field>
            <field name="groups_id" eval="[(4, ref('overtime.group_overtime_hr'))]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face" style="margin-top: 60px;">
                    No hay solicitudes de tiempo extra autorizadas en este rango de fechas.
                </p>
            </field>
        </record>

        <record id="overtime_request_view_search" model="ir.ui.view">
            <field name="name">overtime.search</field>
            <field name="model">overtime</field>
            <field name="arch" type="xml">
                <search string="Buscar Solicitudes de Tiempo Extra">
                    <field name="biometric_id" string="No. Empleado" filter_domain="[('biometric_id', 'ilike', self)]"/>
                    <field name="name" string="Folio" filter_domain="[('name', 'ilike', self)]"/>
                    <field name="employee_id" string="Empleado" filter_domain="[('employee_id', '=', self)]"/>
                    <field name="department_id" string="Departamento" filter_domain="[('department_id', '=', self)]"/>
                    <field name="area_id" string="Área" filter_domain="[('area_id', '=', self)]"/>
                    <field name="requested_date" string="Fecha Solicitada" filter_domain="[('requested_date', '=', self)]"/>
                    
                    <separator/>
                    
                    <filter name="filter_today" 
                            string="Hoy" 
                            domain="[('requested_date', '=', context_today())]"/>
                    
                    <filter name="filter_this_week" 
                            string="Esta Semana" 
                            domain="[('requested_date', '&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('requested_date', '&lt;=', (context_today() + relativedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                    
                    <filter name="filter_this_month" 
                            string="Este Mes" 
                            domain="[('requested_date', '&gt;=', context_today().replace(day=1)), ('requested_date', '&lt;', (context_today().replace(day=1) + relativedelta(months=1)))]"/>
                    
                    <filter name="filter_draft" 
                            string="Borradores" 
                            domain="[('state', '=', 'draft')]"/>
                    
                    <filter name="filter_pending" 
                            string="Pendientes" 
                            domain="[('state', '=', 'pending')]"/>
                    
                    <filter name="filter_approved" 
                            string="Aprobadas" 
                            domain="[('state', '=', 'approved')]"/>
                    
                    <filter name="filter_rejected" 
                            string="Rechazadas" 
                            domain="[('state', '=', 'rejected')]"/>
                    
                    <!-- Filtro para mostrar solo las solicitudes del supervisor actual -->
                    <filter name="my_requests"
                            string="Mis Solicitudes"
                            domain="[('supervisor_id', '=', uid)]"
                            groups="overtime.group_overtime_supervisor"/>
                    
                    <separator/>
                    
                    <group string="Agrupar por" expand="0">
                        <filter name="group_by_employee" 
                                string="Empleado" 
                                context="{'group_by': 'employee_id'}"/>
                        
                        <filter name="group_by_department" 
                                string="Departamento" 
                                context="{'group_by': 'department_id'}"/>
                        
                        <filter name="group_by_state" 
                                string="Estado" 
                                context="{'group_by': 'state'}"/>
                        
                        <filter name="group_by_date" 
                                string="Fecha Solicitada" 
                                context="{'group_by': 'requested_date'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>