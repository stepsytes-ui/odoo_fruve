<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="compras_product_excel_import_wizard_form" model="ir.ui.view">
            <field name="name">compras.product.excel.import.wizard.form</field>
            <field name="model">compras.product.excel.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Importar registros desde Excel">
                    <group>
                        <field name="file_name" invisible="1"/>
                        <field name="file_data" filename="file_name"/>
                    </group>
                    <label
                        for="file_data"
                        string="El archivo debe respetar el orden de columnas definido para Consolidado."
                    />
                    <footer>
                        <button
                            string="Descargar plantilla"
                            type="object"
                            name="action_download_template"
                            class="btn-secondary"
                        />
                        <button
                            string="Importar"
                            type="object"
                            name="action_import_excel"
                            class="btn-primary"
                        />
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="compras_product_excel_import_wizard_action" model="ir.actions.act_window">
            <field name="name">Importar registros desde Excel</field>
            <field name="res_model">compras.product.excel.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
