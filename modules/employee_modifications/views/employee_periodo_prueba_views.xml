<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_employee_periodo_prueba_pendiente_list" model="ir.ui.view">
            <field name="name">hr.employee.periodo.prueba.pendiente.list</field>
            <field name="model">hr.employee</field>
            <field name="arch" type="xml">
                <list string="Pendientes de Renovacion" create="0" delete="0">
                    <field name="biometric_id" string="No. Empleado"/>
                    <field name="name" string="Nombre"/>
                    <field name="department_id" string="Departamento"/>
                    <field name="periodo_prueba"/>
                    <field name="fecha_fin_periodo_prueba" string="Fin de Periodo de Prueba"/>
                    <field name="periodo_prueba_dias_restantes" string="Dias Restantes"/>
                </list>
            </field>
        </record>

        <record id="action_employee_periodo_prueba_pendiente" model="ir.actions.act_window">
            <field name="name">Pendientes de Renovacion</field>
            <field name="res_model">hr.employee</field>
            <field name="view_id" ref="view_employee_periodo_prueba_pendiente_list"/>
            <field name="view_mode">list,form</field>
            <field name="domain">[('periodo_prueba_pendiente_renovacion', '=', True)]</field>
            <field name="context">{'list_view_ref': 'employee_modifications.view_employee_periodo_prueba_pendiente_list'}</field>
        </record>

        <menuitem
            id="menu_hr_employee_periodo_prueba_pendiente"
            name="Pendientes de Renovacion"
            parent="menu_hr_herramientas"
            action="action_employee_periodo_prueba_pendiente"
            sequence="14"
            groups="zkteco_realtime_connector.group_hr_manager_custom,zkteco_realtime_connector.group_rh_absence_manager"/>

    </data>
</odoo>
