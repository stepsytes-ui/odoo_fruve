<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="zkteco_realtime_connector.AttendanceDashboardWrapper" owl="1">
        <div class="o_attendance_dashboard_wrapper d-flex flex-column h-100" role="region">
            
            <div class="o_dashboard_header flex-shrink-0">
                <AttendanceKanbanDashboard onFilter="(s, e) => this.onDashboardFilter(s, e)"/>
            </div>

            <div class="o_dashboard_content flex-grow-1 position-relative">
                <div class="o_dashboard_scroll_area h-100 overflow-auto">
                    <DynamicView t-props="dynamicViewProps" t-key="viewKey"/>
                </div>
            </div>

        </div>
    </t>
</templates> 