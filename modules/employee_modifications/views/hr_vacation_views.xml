<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de formulario para hr.vacation -->
        <record id="view_hr_vacation_form" model="ir.ui.view">
            <field name="name">hr.vacation.form</field>
            <field name="model">hr.vacation</field>
            <field name="arch" type="xml">
                <form string="Vacación">
                    <header>
                        <button name="action_confirm" string="Confirmar" type="object" 
                                invisible="state != 'draft'" class="btn-primary"/>
                        <button name="action_validate" string="Aprobar" type="object" 
                                invisible="state not in ['confirm', 'validate1']" class="btn-primary"/>
                        <button name="action_refuse" string="Rechazar" type="object" 
                                invisible="state not in ['confirm', 'validate1']" class="btn-warning"/>
                        <button name="action_cancel" string="Cancelar" type="object" 
                                invisible="state not in ['draft', 'confirm', 'validate1']" class="btn-danger"/>
                        <button name="action_draft" string="Volver a Borrador" type="object" 
                                invisible="state != 'cancel'"/>
                        <button name="action_open_leave" string="Ver Solicitud" type="object" 
                                class="btn-secondary" icon="fa-external-link"/>
                        <field name="state" widget="statusbar" 
                               statusbar_visible="draft,confirm,validate"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Información del Empleado">
                                <field name="employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="biometric_id" readonly="1"/>
                                <field name="employee_name" readonly="1"/>
                                <field name="department_id" readonly="1"/>
                                <field name="turno_id" readonly="1"/>
                            </group>
                            <group string="Información de Vacaciones">
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="duration_days" readonly="1"/>
                                <field name="vacation_days_available" readonly="1"/>
                                <field name="employee_antiguedad" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="supervisor_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="registered_by_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="company_id" invisible="1"/>
                                <field name="leave_id" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" placeholder="Describa detalles adicionales..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista de lista para hr.vacation -->
        <record id="view_hr_vacation_tree" model="ir.ui.view">
            <field name="name">hr.vacation.tree</field>
            <field name="model">hr.vacation</field>
            <field name="arch" type="xml">
                <list string="Vacaciones" decoration-info="state == 'draft'" 
                      decoration-muted="state in ['cancel', 'refuse']" 
                      decoration-success="state == 'validate'">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="biometric_id"/>
                    <field name="department_id"/>
                    <field name="turno_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="duration_days"/>
                    <field name="supervisor_id"/>
                    <field name="registered_by_id"/>
                    <field name="state" 
                           decoration-info="state == 'draft'" 
                           decoration-success="state == 'validate'" 
                           decoration-warning="state in ['confirm', 'validate1']" 
                           decoration-danger="state == 'refuse'" 
                           widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Vista de búsqueda para hr.vacation -->
        <record id="view_hr_vacation_search" model="ir.ui.view">
            <field name="name">hr.vacation.search</field>
            <field name="model">hr.vacation</field>
            <field name="arch" type="xml">
                <search string="Buscar Vacaciones">
                    <field name="name" string="Referencia"/>
                    <field name="employee_id"/>
                    <field name="biometric_id"/>
                    <field name="department_id"/>
                    <field name="turno_id"/>
                    <field name="supervisor_id"/>
                    <separator/>
                    <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Confirmado" name="confirm" domain="[('state', '=', 'confirm')]"/>
                    <filter string="Aprobado" name="validate" domain="[('state', '=', 'validate')]"/>
                    <filter string="Rechazado" name="refuse" domain="[('state', '=', 'refuse')]"/>
                    <filter string="Cancelado" name="cancel" domain="[('state', '=', 'cancel')]"/>
                    <separator/>
                    <filter string="Mes Actual" name="current_month" 
                            domain="[('date_from', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                     ('date_from', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Departamento" name="group_department" context="{'group_by': 'department_id'}"/>
                        <filter string="Turno" name="group_turno" context="{'group_by': 'turno_id'}"/>
                        <filter string="Supervisor" name="group_supervisor" context="{'group_by': 'supervisor_id'}"/>
                        <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Fecha Inicio" name="group_date_from" context="{'group_by': 'date_from'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Acción para abrir vacaciones -->
        <record id="action_hr_vacation" model="ir.actions.act_window">
            <field name="name">Vacaciones</field>
            <field name="res_model">hr.vacation</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear un nuevo registro de vacaciones
                </p>
                <p>
                    Las vacaciones se crean automáticamente cuando se aprueba una ausencia de tipo "Vacaciones".
                    También puede crear registros manualmente aquí.
                </p>
            </field>
        </record>

        <!-- Menú para vacaciones -->
        <menuitem id="menu_hr_vacation"
                  name="Vacaciones"
                  parent="hr.menu_hr_root"
                  action="action_hr_vacation"
                  sequence="51"/>

        <!-- Agregar campos de información de vacaciones en hr.leave -->
        <record id="view_hr_leave_form_vacation_info" model="ir.ui.view">
            <field name="name">hr.leave.form.vacation.info</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">
                <!-- Agregar campos después del campo holiday_status_id -->
                <xpath expr="//field[@name='holiday_status_id']" position="after">
                    <field name="is_vacation" invisible="1"/>
                    <field name="vacation_id" invisible="1"/>
                    <field name="vacation_days_available" 
                           invisible="not is_vacation"
                           readonly="1"
                           string="Días Disponibles"/>
                    <field name="employee_antiguedad" 
                           invisible="not is_vacation"
                           readonly="1"
                           string="Antigüedad"/>
                </xpath>
            </field>
        </record>

        <!-- Extender vista de hr.employee para agregar botón de Vacaciones -->
        <record id="view_employee_form_inherit_vacation_button" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.vacation.button</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="employee_modifications.view_employee_form_inherit_permission_button"/>
            <field name="arch" type="xml">
                <!-- Agregar botón de Vacaciones después del botón de Permisos -->
                <xpath expr="//button[@name='action_view_permissions']" position="after">
                    <button name="action_view_vacations"
                            type="object"
                            string="Vacaciones"
                            class="btn-secondary"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
