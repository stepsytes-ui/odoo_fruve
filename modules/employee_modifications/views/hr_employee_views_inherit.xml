<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vista heredada del formulario para ocultar pestañas del grupo read_employees -->
    <record id="view_employee_form_read_only_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.read_only.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            
            <!-- Ocultar la pestaña de Información Privada para read_employees -->
            <page name="personal_information" position="attributes">
                <attribute name="groups">hr.group_hr_user,!employee_modifications.group_hr_read_employees</attribute>
            </page>
            
            <!-- Ocultar la pestaña de Ajustes para read_employees -->
            <page name="hr_settings" position="attributes">
                <attribute name="groups">hr.group_hr_user,!employee_modifications.group_hr_read_employees</attribute>
            </page>
            
            <!-- Ocultar botón Launch Plan para read_employees -->
            <xpath expr="//header/button[@name='%(hr.plan_wizard_action)d']" position="attributes">
                <attribute name="groups">hr.group_hr_user,!employee_modifications.group_hr_read_employees</attribute>
            </xpath>
            
        </field>
    </record>

    <!-- Vista heredada de lista para agregar biometric_id -->
    <record id="view_employee_tree_biometric_inherit" model="ir.ui.view">
        <field name="name">hr.employee.tree.biometric.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            
            <!-- Agregar biometric_id después del nombre en la lista -->
            <field name="name" position="after">
                <field name="biometric_id" string="No. Empleado" optional="show"/>
            </field>
            
        </field>
    </record>

    <!-- Vista heredada de búsqueda para agregar biometric_id como campo de búsqueda -->
    <record id="view_employee_filter_biometric_inherit" model="ir.ui.view">
        <field name="name">hr.employee.search.biometric.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            
            <!-- Modificar el campo de búsqueda principal para incluir biometric_id -->
            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', '|', ('work_email', 'ilike', self), ('name', 'ilike', self), ('biometric_id', 'ilike', self)]</attribute>
            </field>
            
        </field>
    </record>

</odoo>
