<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_maintenance_request" model="report.paperformat">
        <field name="name">Solicitud de mantenimiento A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">13</field>
        <field name="margin_right">13</field>
        <field name="header_spacing">8</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_maintenance_request" model="ir.actions.report">
        <field name="name">Solicitud de mantenimiento</field>
        <field name="model">fruve.maintenance.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">maintenance_fruvemex.maintenance_request_report</field>
        <field name="report_file">maintenance_fruvemex.maintenance_request_report</field>
        <field name="print_report_name">'Solicitud de mantenimiento - %s' % (object.folio or '')</field>
        <field name="binding_model_id" ref="model_fruve_maintenance_request"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="maintenance_fruvemex.paperformat_maintenance_request"/>
    </record>

    <template id="maintenance_request_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="request">
                <t t-set="company" t-value="request.user_id.company_id or res_company"/>
                <t t-call="web.external_layout_bold">
                    <div class="page" style="font-family: Arial, sans-serif; color: #273444; padding-top: 10mm; box-sizing: border-box;">
                        <div style="border-bottom: 4px solid #1f6f78; padding-bottom: 14px; margin-bottom: 22px;">
                            <div style="display: inline-block; width: 64%; vertical-align: top;">
                                <h1 style="color: #1f6f78; font-size: 25px; margin: 0 0 5px 0;">Solicitud de mantenimiento</h1>
                                <div style="color: #687385; font-size: 12px;">ORDEN DE SERVICIO INTERNA</div>
                            </div>
                            <div style="display: inline-block; width: 34%; text-align: right; vertical-align: top;">
                                <div style="font-size: 11px; color: #687385;">FOLIO</div>
                                <div style="font-size: 22px; font-weight: bold; color: #273444;" t-field="request.folio"/>
                            </div>
                        </div>

                        <table style="width: 100%; border-collapse: separate; border-spacing: 0; margin-bottom: 20px; font-size: 12px;">
                            <tr>
                                <td style="width: 50%; padding: 11px; background-color: #eef6f7; border: 1px solid #d6e5e7;">
                                    <strong style="color: #1f6f78;">SOLICITANTE</strong><br/>
                                    <span t-field="request.solicitante_id"/>
                                </td>
                                <td style="width: 50%; padding: 11px; background-color: #eef6f7; border: 1px solid #d6e5e7; border-left: 0;">
                                    <strong style="color: #1f6f78;">ÁREA</strong><br/>
                                    <span t-field="request.area_id"/>
                                </td>
                            </tr>
                        </table>

                        <h2 style="font-size: 14px; color: #1f6f78; border-bottom: 1px solid #cbd7dc; padding-bottom: 7px; margin: 0 0 10px 0;">Datos de la solicitud</h2>
                        <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 22px;">
                            <tr>
                                <td style="width: 25%; padding: 7px 0; color: #687385;">Registró</td>
                                <td style="width: 25%; padding: 7px 0; font-weight: bold;"><span t-field="request.user_id"/></td>
                                <td style="width: 25%; padding: 7px 0; color: #687385;">Fecha de registro</td>
                                <td style="width: 25%; padding: 7px 0; font-weight: bold;"><span t-field="request.fecha_registro" t-options="{'widget': 'datetime'}"/></td>
                            </tr>
                            <tr style="background-color: #f7f9fa;">
                                <td style="padding: 7px 0; color: #687385;">Clasificación</td>
                                <td style="padding: 7px 0; font-weight: bold;"><span t-field="request.clasificacion"/></td>
                                <td style="padding: 7px 0; color: #687385;">Prioridad</td>
                                <td style="padding: 7px 0; font-weight: bold;"><span t-field="request.prioridad"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 7px 0; color: #687385;">Unidad</td>
                                <td style="padding: 7px 0; font-weight: bold;"><span t-field="request.tipo_id"/></td>
                                <td style="padding: 7px 0; color: #687385;">Tiempo extra</td>
                                <td style="padding: 7px 0; font-weight: bold;"><span t-out="'Sí' if request.tiempo_extra else 'No'"/></td>
                            </tr>
                            <tr style="background-color: #f7f9fa;">
                                <td style="padding: 7px 0; color: #687385;">Técnicos</td>
                                <td colspan="3" style="padding: 7px 0; font-weight: bold;"><span t-out="', '.join(request.technician_ids.mapped('employee_id.name')) or 'Sin asignar'"/></td>
                            </tr>
                        </table>

                        <h2 style="font-size: 14px; color: #1f6f78; border-bottom: 1px solid #cbd7dc; padding-bottom: 7px; margin: 0 0 10px 0;">Descripción del trabajo solicitado</h2>
                        <div style="min-height: 95px; border: 1px solid #d6dde1; padding: 12px; font-size: 12px; white-space: pre-wrap; margin-bottom: 22px;">
                            <span t-field="request.descripcion"/>
                        </div>

                        <h2 style="font-size: 14px; color: #1f6f78; border-bottom: 1px solid #cbd7dc; padding-bottom: 7px; margin: 0 0 10px 0;">Control de atención</h2>
                        <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 22px;">
                            <tr>
                                <td style="width: 25%; padding: 8px; border: 1px solid #d6dde1; color: #687385;">Fecha asignada</td>
                                <td style="width: 25%; padding: 8px; border: 1px solid #d6dde1; font-weight: bold;"><span t-field="request.fecha_asignada" t-options="{'widget': 'datetime'}"/></td>
                                <td style="width: 25%; padding: 8px; border: 1px solid #d6dde1; color: #687385;">Fecha de cierre</td>
                                <td style="width: 25%; padding: 8px; border: 1px solid #d6dde1; font-weight: bold;"><span t-field="request.fecha_cierre" t-options="{'widget': 'datetime'}"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; border: 1px solid #d6dde1; color: #687385;">Horas totales</td>
                                <td colspan="3" style="padding: 8px; border: 1px solid #d6dde1; font-weight: bold;"><span t-field="request.horas_totales" t-options="{'widget': 'float', 'precision': 2}"/> horas</td>
                            </tr>
                        </table>

                        <div style="display: inline-block; width: 48%; vertical-align: top; margin-right: 3%;">
                            <h2 style="font-size: 14px; color: #1f6f78; border-bottom: 1px solid #cbd7dc; padding-bottom: 7px;">Solución y herramientas</h2>
                            <div style="min-height: 75px; border: 1px solid #d6dde1; padding: 10px; font-size: 12px; white-space: pre-wrap;"><span t-field="request.solucion"/></div>
                            <div style="min-height: 45px; border: 1px solid #d6dde1; border-top: 0; padding: 10px; font-size: 12px; white-space: pre-wrap;"><strong>Herramientas: </strong><span t-field="request.herramientas"/></div>
                        </div>
                        <div style="display: inline-block; width: 48%; vertical-align: top;">
                            <h2 style="font-size: 14px; color: #1f6f78; border-bottom: 1px solid #cbd7dc; padding-bottom: 7px;">Autorización y recepción</h2>
                            <div style="height: 125px; border: 1px solid #d6dde1; padding: 10px; font-size: 11px; color: #687385;">Observaciones:</div>
                        </div>

                        <table style="width: 100%; margin-top: 45px; font-size: 11px; text-align: center;">
                            <tr>
                                <td style="width: 33%; border-top: 1px solid #687385; padding-top: 8px;">Solicitante</td>
                                <td style="width: 33%; border-top: 1px solid #687385; padding-top: 8px;">Responsable de mantenimiento</td>
                                <td style="width: 33%; border-top: 1px solid #687385; padding-top: 8px;">Recibido por mantenimiento</td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>