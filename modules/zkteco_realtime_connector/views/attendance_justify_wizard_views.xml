<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_attendance_justify_wizard_form" model="ir.ui.view">
            <field name="name">attendance.justify.wizard.form</field>
            <field name="model">attendance.justify.wizard</field>
            <field name="arch" type="xml">
                <form string="Justificar Asistencias">
                    <group>
                        <field name="turno_id" required="1"/>
                        <field name="date_to_justify" required="1"/>
                        <field name="date_displaced_checks" required="1"/>
                    </group>
                    <footer>
                        <button name="action_justify_attendances" string="Justificar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="attendance_justify_wizard_action" model="ir.actions.act_window">
            <field name="name">Justificar Asistencias</field>
            <field name="res_model">attendance.justify.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
