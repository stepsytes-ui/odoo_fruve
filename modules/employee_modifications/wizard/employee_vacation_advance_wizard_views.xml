<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_vacation_advance_warning_wizard_form" model="ir.ui.view">
            <field name="name">employee.vacation.advance.warning.wizard.form</field>
            <field name="model">employee.vacation.advance.warning.wizard</field>
            <field name="arch" type="xml">
                <form string="Vacaciones sin saldo suficiente">
                    <sheet>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="days_requested" readonly="1"/>
                            <field name="days_available" readonly="1"/>
                            <field name="shortage_days" readonly="1"/>
                        </group>
                        <group>
                            <div class="o_form_label">El empleado no cuenta con días suficientes de vacaciones.</div>
                            <div class="o_form_label">¿Desea adelantar días de vacaciones para este empleado?</div>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_open_advance_days_wizard" string="Sí, adelantar" type="object" class="btn-primary"/>
                        <button string="No" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_employee_vacation_advance_days_wizard_form" model="ir.ui.view">
            <field name="name">employee.vacation.advance.days.wizard.form</field>
            <field name="model">employee.vacation.advance.days.wizard</field>
            <field name="arch" type="xml">
                <form string="Adelantar días de vacaciones">
                    <sheet>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="days_requested" readonly="1"/>
                            <field name="days_available" readonly="1"/>
                            <field name="shortage_days" readonly="1"/>
                            <field name="days_to_advance"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm_advance_days" string="Confirmar adelanto" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
