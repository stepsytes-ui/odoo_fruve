<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron diario para avisar a RH sobre empleados por cumplir su periodo de prueba -->
        <record id="ir_cron_alerta_periodo_prueba" model="ir.cron">
            <field name="name">Alerta de Periodo de Prueba por Vencer</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._cron_alerta_periodo_prueba()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
