<odoo>
	<data noupdate="1">
		<record id="seq_partner_customer_auto_id" model="ir.sequence">
			<field name="name">Customer Auto ID</field>
			<field name="code">customer_polair.partner.auto.id</field>
			<field name="implementation">no_gap</field>
			<field name="padding">6</field>
			<field name="number_increment">1</field>
			<field name="number_next">1</field>
		</record>

		<record id="ir_cron_assign_customer_auto_id" model="ir.cron">
			<field name="name">Asignar ID automatico a clientes</field>
			<field name="active" eval="True"/>
			<field name="interval_number">10</field>
			<field name="interval_type">minutes</field>
			<field name="model_id" ref="base.model_res_partner"/>
			<field name="state">code</field>
			<field name="code">model._cron_assign_customer_auto_id()</field>
			<field name="user_id" ref="base.user_root"/>
			<field name="priority">5</field>
		</record>
	</data>
</odoo>
