<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_resguardo_assign_wizard_form" model="ir.ui.view">
            <field name="name">employee.resguardo.assign.wizard.form</field>
            <field name="model">employee.resguardo.assign.wizard</field>
            <field name="arch" type="xml">
                <form string="Asignar Resguardo al Empleado">
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id" readonly="1"/>
                                <field name="fecha_entrega"/>
                            </group>
                            <group>
                                <field name="responsable_rh_id"/>
                            </group>
                        </group>

                        <group string="Objetos Prestados">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="asset_id" options="{'no_create': False}"/>
                                    <field name="tipo_resguardo" readonly="1"/>
                                    <field name="funcionando_al_entregar"/>
                                    <field name="observaciones" optional="show"/>
                                </list>
                            </field>
                        </group>

                    </sheet>
                    <footer>
                        <button name="action_confirm_assign" string="Crear Resguardo" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
