<odoo>
    <data>
        <record id="view_production_attendance_list" model="ir.ui.view">
            <field name="name">hr.attendance.production.list</field>
            <field name="model">hr.attendance</field>
            <field name="arch" type="xml">
                <list string="Asistencia de Producción">
                    <field name="employee_id"/>
                    <field name="check_in"/>
                    <field name="check_out"/>
                    <field name="worked_hours" widget="float_time"/>
                </list>
            </field>
        </record>

        <record id="action_production_attendance" model="ir.actions.act_window">
            <field name="name">Asistencia (Producción)</field>
            <field name="res_model">hr.attendance</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No hay registros de asistencia para el personal de Producción.
                </p>
            </field>
        </record>

        <menuitem id="menu_top_level_production_app" 
                  name="Asistencia Producción" 
                  sequence="100" 
                  web_icon="base,static/description/settings.png"
                  groups="attendance_production.group_production_admin"/> 
        
        <menuitem id="menu_production_attendance_entry" 
                  name="Asistencia de Producción" 
                  parent="menu_top_level_production_app" 
                  sequence="10" 
                  action="action_production_attendance"
                  groups="attendance_production.group_production_admin"/>

    </data>

    </odoo>