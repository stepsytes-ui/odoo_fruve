<odoo>
    <data>
        <!-- Acción para supervisores y guardias para ver la lista de empleados -->
        <record id="action_employee_list_supervisor" model="ir.actions.act_window">
            <field name="name">Empleados</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('hr.hr_kanban_view_employees'), 'sequence': 1}),
                (0, 0, {'view_mode': 'list', 'view_id': ref('hr.view_employee_tree'), 'sequence': 2}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('hr.view_employee_form'), 'sequence': 3}),
            ]"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <!-- Menú específico para supervisores: Lista de empleados -->
        <menuitem 
            id="menu_hr_employee_list_supervisor" 
            name="Empleados" 
            parent="hr.menu_hr_root"
            action="action_employee_list_supervisor"
            groups="employee_modifications.group_supervisor,employee_modifications.group_guardia"
            sequence="3"/>
        
        <!-- Menú Principal: Herramientas -->
        <menuitem 
            id="menu_hr_herramientas" 
            name="Herramientas" 
            parent="hr.menu_hr_root" 
            sequence="100"
            groups="hr.group_hr_user"/> 
        
        <!-- Submenú: Expedientes -->
        <menuitem 
            id="menu_hr_employee_view_expedient" 
            name="Expedientes" 
            parent="menu_hr_herramientas" 
            sequence="10"
            groups="hr.group_hr_manager" 
            action="employee_modifications.employee_expedient_action"/> 

        <!-- Submenú: Lista de Empleados -->
        <menuitem
            id="menu_hr_employee_lista"
            name="Lista"
            parent="menu_hr_herramientas"
            action="employee_modifications.action_employee_tools_lista"
            sequence="11"
            groups="hr.group_hr_user"/>

        <menuitem
            id="menu_hr_employee_export_lista_datos"
            name="Exportar lista de datos"
            parent="menu_hr_herramientas"
            action="employee_modifications.action_open_export_employee_list_wizard"
            sequence="12"
            groups="hr.group_hr_user"/>
        
        <record id="view_hr_area_list_tools" model="ir.ui.view">
            <field name="name">hr.area.list.tools</field>
            <field name="model">hr.area</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="department_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="employee_count"/>
                </list>
            </field>
        </record>

        <record id="view_hr_area_search_tools" model="ir.ui.view">
            <field name="name">hr.area.search.tools</field>
            <field name="model">hr.area</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="department_id"/>
                    <group expand="0" string="Agrupar por">
                        <filter name="group_department" string="Departamento" context="{'group_by': 'department_id'}"/>
                        <filter name="group_company" string="Empresa" context="{'group_by': 'company_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_hr_area_tools" model="ir.actions.act_window">
            <field name="name">Áreas</field>
            <field name="res_model">hr.area</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
            <field name="context">{'search_default_group_department': 1}</field>
        </record>

        <menuitem
            id="menu_hr_area_herramientas"
            name="Áreas"
            parent="menu_hr_herramientas"
            action="action_hr_area_tools"
            sequence="13"
            groups="hr.group_hr_user"/>

        <!-- Submenú: Suspensiones -->

        <menuitem 
            id="menu_hr_suspension" 
            name="Suspensiones" 
            parent="menu_hr_herramientas" 
            sequence="20"
            groups="hr.group_hr_manager" 
            action="action_hr_suspension"/> 
        
        <!-- Submenú: Incapacidades -->
        <menuitem 
            id="menu_hr_incapacity" 
            name="Incapacidades" 
            parent="menu_hr_herramientas" 
            sequence="30"
            groups="hr.group_hr_manager" 
            action="action_hr_incapacity"/> 
        
        <!-- Submenú: Amonestaciones -->
        <menuitem 
            id="menu_employee_warning_herramientas"
              name="Amonestaciones"
              parent="menu_hr_herramientas"
              action="action_employee_warning"
              sequence="40"
              groups="hr.group_hr_user"/>
        
        <!-- Submenú: Archivos de Empleados -->
        <menuitem 
            id="menu_employee_documents_herramientas"
              name="Archivos de Empleados"
              parent="menu_hr_herramientas"
              action="action_employee_documents"
              sequence="50"
              groups="hr.group_hr_user"/>

        <!-- Subenú para permisos -->
        <menuitem id="menu_hr_permission"
                  name="Permisos"
                  parent="menu_hr_herramientas"
                  action="action_hr_permission"
                  sequence="50"
                  groups="hr.group_hr_user"/>

                <!-- Menú para vacaciones -->
        <menuitem id="menu_hr_vacation"
                  name="Vacaciones"
                  parent="menu_hr_herramientas"
                  action="action_hr_vacation"
                  sequence="51"
                  groups="hr.group_hr_user"/>

        <record id="menu_hr_resguardo" model="ir.ui.menu">
            <field name="name">Resguardos</field>
            <field name="parent_id" ref="employee_modifications.menu_hr_herramientas"/>
            <field name="action" ref="employee_modifications.action_employee_resguardo"/>
            <field name="sequence">52</field>
            <field name="groups_id" eval="[(6, 0, [ref('hr.group_hr_user')])]"/>
        </record>

        <record id="menu_hr_resguardo_asset" model="ir.ui.menu">
            <field name="name">Catalogo de Objetos Resguardo</field>
            <field name="parent_id" ref="employee_modifications.menu_hr_herramientas"/>
            <field name="action" ref="employee_modifications.action_employee_resguardo_asset"/>
            <field name="sequence">53</field>
            <field name="groups_id" eval="[(6, 0, [ref('hr.group_hr_user')])]"/>
        </record>
        
        <!-- Submenú: Reportes (placeholder - agregar acción cuando esté lista) -->
        <menuitem 
            id="menu_hr_reportes"
              name="Reportes"
              parent="menu_hr_herramientas"
              sequence="60"
              groups="hr.group_hr_user"/>
        
        <!-- Submenú: Importar CURP, RFC y NSS -->
        <menuitem 
            id="menu_import_curp_rfc_herramientas"
              name="Importar CURP, RFC y NSS"
              parent="menu_hr_herramientas"
              action="action_import_curp_rfc_wizard"
              sequence="70"
              groups="hr.group_hr_user"/>
    
    </data>
</odoo>
