<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="compras_product_alert_wizard_form" model="ir.ui.view">
            <field name="name">compras.product.alert.wizard.form</field>
            <field name="model">compras.product.alert.wizard</field>
            <field name="arch" type="xml">
                <form string="Alertas de compras">
                    <sheet>
                        <div class="oe_title">
                            <h1>Productos que requieren atención</h1>
                        </div>
                        <group col="4">
                            <field name="total_alert_count" readonly="1"/>
                            <field name="min_alert_count" readonly="1"/>
                            <field name="expiration_alert_count" readonly="1"/>
                        </group>
                        <separator string="Resumen"/>
                        <div class="o_form_label">
                            Se muestran productos que ya llegaron al mínimo y productos cuya fecha de caducidad vence en los próximos 30 días.
                        </div>
                        <field name="line_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0" default_order="alert_expiration desc, days_to_expire asc, name asc">
                                <field name="code"/>
                                <field name="name"/>
                                <field name="alert_reason"/>
                                <field name="qty_on_hand"/>
                                <field name="min_qty"/>
                                <field name="expiration_date"/>
                                <field name="days_to_expire"/>
                                <field name="alert_min_qty" widget="boolean_toggle"/>
                                <field name="alert_expiration" widget="boolean_toggle"/>
                            </list>
                        </field>
                    </sheet>
                    <footer>
                        <button string="Cerrar" class="btn-primary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="compras_product_alert_wizard_action" model="ir.actions.act_window">
            <field name="name">Alertas de compras</field>
            <field name="res_model">compras.product.alert.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>