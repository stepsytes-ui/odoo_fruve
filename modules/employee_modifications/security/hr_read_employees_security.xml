<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Grupo de Solo Lectura de Empleados -->
    <record id="group_hr_read_employees" model="res.groups">
        <field name="name">Read Employees: View employees in read-only mode</field>
        <field name="category_id" ref="base.module_category_human_resources_employees"/>
        <field name="comment">Users in this group can view employees and use them in other models, but cannot edit employee information, curriculum, work info, private info, or settings.</field>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <!-- Grupo de Supervisores -->
    <record id="group_supervisor" model="res.groups">
        <field name="name">Supervisores</field>
        <field name="category_id" ref="base.module_category_human_resources_employees"/>
        <field name="comment">Supervisores que pueden ver amonestaciones pero no pueden editar, crear o eliminar empleados.</field>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <!-- Grupo de Guardias -->
    <record id="group_guardia" model="res.groups">
        <field name="name">Guardias de Seguridad</field>
        <field name="category_id" ref="base.module_category_human_resources_employees"/>
        <field name="comment">Guardias de seguridad que pueden ver amonestaciones pero no pueden editar, crear o eliminar empleados.</field>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user'), ref('security_view_time_off.group_time_off_security')])]"/>
    </record>

    <!-- Regla de registro: Amonestaciones filtradas por empresa del usuario -->
    <record id="employee_warning_rule_company" model="ir.rule">
        <field name="name">Amonestaciones: Multi-empresa</field>
        <field name="model_id" ref="employee_modifications.model_employee_warning"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

    <!-- Regla de registro: Supervisores y Guardias no pueden crear ni eliminar empleados -->
    <record id="hr_employee_rule_supervisor_guardia_no_create_delete" model="ir.rule">
        <field name="name">Empleados: Supervisores/Guardias - No crear/eliminar</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_supervisor')), (4, ref('group_guardia'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Regla de registro: Supervisores por compañia -->
    <record id="employee_supervisor_rule_company" model="ir.rule">
        <field name="name">Supervisores: Multi-empresa</field>
        <field name="model_id" ref="employee_modifications.model_employee_supervisor"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

</odoo>
