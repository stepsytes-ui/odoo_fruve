<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista lista de incapacidades -->
    <record id="view_hr_incapacity_list" model="ir.ui.view">
        <field name="name">hr.incapacity.list</field>
        <field name="model">hr.incapacity</field>
        <field name="arch" type="xml">
            <list string="Incapacidades" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="biometric_id"/>
                <field name="employee_name"/>
                <field name="department_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_days"/>
                <field name="incapacity_type"/>
                <field name="state" 
                       decoration-success="state == 'validate'"
                       decoration-info="state == 'confirm'"
                       decoration-muted="state in ['refuse', 'cancel']"
                       decoration-warning="state == 'draft'"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario de incapacidades -->
    <record id="view_hr_incapacity_form" model="ir.ui.view">
        <field name="name">hr.incapacity.form</field>
        <field name="model">hr.incapacity</field>
        <field name="arch" type="xml">
            <form string="Incapacidad">
                <header>
                    <button name="action_confirm" 
                            type="object" 
                            string="Confirmar" 
                            invisible="state != 'draft'" 
                            class="oe_highlight"/>
                    <button name="action_validate" 
                            type="object" 
                            string="Aprobar" 
                            invisible="state != 'confirm'" 
                            class="oe_highlight"/>
                    <button name="action_refuse" 
                            type="object" 
                            string="Rechazar" 
                            invisible="state not in ['draft', 'confirm']"/>
                    <button name="action_cancel" 
                            type="object" 
                            string="Cancelar" 
                            invisible="state not in ['draft', 'confirm', 'validate']"/>
                    <button name="action_draft" 
                            type="object" 
                            string="Regresar a Borrador" 
                            invisible="state != 'refuse'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,validate"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Información del Empleado">
                            <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="biometric_id"/>
                            <field name="department_id" readonly="1"/>
                            <field name="supervisor_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Información de la Incapacidad">
                            <field name="incapacity_type"/>
                            <field name="date_from"/>
                            <field name="total_days"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group string="Comentarios">
                        <field name="comments" nolabel="1" placeholder="Comentarios sobre la incapacidad..."/>
                    </group>
                    
                    <notebook>
                        <page string="Información Adicional">
                            <group>
                                <field name="leave_id" readonly="1"/>
                                <field name="notes" placeholder="Notas adicionales..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda de incapacidades -->
    <record id="view_hr_incapacity_search" model="ir.ui.view">
        <field name="name">hr.incapacity.search</field>
        <field name="model">hr.incapacity</field>
        <field name="arch" type="xml">
            <search string="Buscar Incapacidades">
                <field name="name" string="Referencia"/>
                <field name="employee_id"/>
                <field name="biometric_id" string="Número de Empleado"/>
                <field name="department_id"/>
                <field name="incapacity_type"/>
                <separator/>
                <filter string="Borradores" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmadas" name="confirmed" domain="[('state', '=', 'confirm')]"/>
                <filter string="Aprobadas" name="validated" domain="[('state', '=', 'validate')]"/>
                <filter string="Rechazadas" name="refused" domain="[('state', '=', 'refuse')]"/>
                <separator/>
                <filter string="Riesgo Trabajo" name="riesgo_trabajo" domain="[('incapacity_type', '=', 'riesgo_trabajo')]"/>
                <filter string="Enfermedad Trabajo" name="enfermedad_trabajo" domain="[('incapacity_type', '=', 'enfermedad_trabajo')]"/>
                <filter string="Enfermedad General" name="enfermedad_general" domain="[('incapacity_type', '=', 'enfermedad_general')]"/>
                <filter string="Maternidad" name="maternidad" domain="[('incapacity_type', '=', 'maternidad')]"/>
                <separator/>
                <filter string="Mes Actual" name="current_month" 
                        domain="[('date_from', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%%Y-%%m-%%d')),
                                ('date_from', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%%Y-%%m-%%d'))]"/>
                <filter string="Año Actual" name="current_year" 
                        domain="[('date_from', '&gt;=', context_today().strftime('%%Y-01-01')),
                                ('date_from', '&lt;=', context_today().strftime('%%Y-12-31'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Departamento" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Motivo" name="group_type" context="{'group_by': 'incapacity_type'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Mes" name="group_month" context="{'group_by': 'date_from:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción para abrir las incapacidades -->
    <record id="action_hr_incapacity" model="ir.actions.act_window">
        <field name="name">Incapacidades</field>
        <field name="res_model">hr.incapacity</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay incapacidades registradas
            </p>
            <p>
                Las incapacidades se crean automáticamente desde las solicitudes de ausencias de tipo "Incapacidad".
            </p>
        </field>
    </record>

    <!-- Extender vista de hr.leave para mostrar campos de incapacidad -->
    <record id="view_hr_leave_form_incapacity_fields" model="ir.ui.view">
        <field name="name">hr.leave.form.incapacity.fields</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <!-- Campo de Total Días después de las fechas -->
            <xpath expr="//field[@name='date_to']" position="after">
                <field name="is_incapacity" invisible="1"/>
                <field name="total_days_incapacity" 
                       invisible="not is_incapacity" 
                       required="is_incapacity"/>
                <field name="incapacity_id" invisible="1"/>
            </xpath>
            <!-- Campo de Motivo antes de Descripción -->
            <xpath expr="//field[@name='name']" position="before">
                <field name="incapacity_type" 
                       invisible="not is_incapacity" 
                       required="is_incapacity"/>
            </xpath>
        </field>
    </record>

    <!-- Extender vista de hr.employee para agregar botón de Incapacidades -->
    <record id="view_employee_form_inherit_incapacity_button" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.incapacity.button</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="employee_modifications.view_hr_employee_form_suspension_button"/>
        <field name="arch" type="xml">
            <!-- Agregar botón de Incapacidades después del botón de Suspensiones -->
            <xpath expr="//button[@name='action_view_suspensions']" position="after">
                <button name="action_view_incapacities"
                        type="object"
                        string="Incapacidades"
                        class="btn-secondary"
                        groups="hr.group_hr_user"/>
            </xpath>
        </field>
    </record>

</odoo>
