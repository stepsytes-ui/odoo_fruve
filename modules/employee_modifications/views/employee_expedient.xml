<odoo>
    <data>
        <record id="view_employee_expedient_list" model="ir.ui.view">
            <field name="name">employee.expedient.list</field>
            <field name="model">employee.expedient</field>
            <field name="arch" type="xml">
                <list string="Expedientes de Empleados" default_order="fecha_movimiento desc" editable="bottom" create="0" edit="0">
                    <field name="numero_empleado"/> 
                    <field name="employee_id"/>
                    <field name="employee_status"/>
                    <field name="tipo_registro"/>
                    <field name="fecha_movimiento"/>
                    <field name="antiguedad"/> 
                    <field name="dias_vacaciones_disponibles"/>
                    <field name="recontratable" widget="toggle_button" options="{'positive': 'si', 'negative': 'no', 'default': 'n/a'}"/>
                    <field name='genero'/> 
                    <field name="employee_id" widget="badge" 
                        decoration-warning="employee_id.employee_status == 'inactive' and not employee_id.finiquitado"
                        decoration-muted="employee_id.finiquitado" invisible="1"/>
                    <field name="hoja_renuncia_convenio" filename="nombre_hoja_renuncia" string="Renuncia/Convenio" widget="attachment" class="oe_no_link"/>
                    <field name="encuesta" filename="nombre_encuesta" string="Encuesta" widget="attachment" class="oe_no_link"/>
                    <field name="nombre_hoja_renuncia" string=" " invisible="1"/>
                    <field name="nombre_encuesta" string=" " invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_employee_expedient_search" model="ir.ui.view">
            <field name="name">employee.expedient.search</field>
            <field name="model">employee.expedient</field>
            <field name="arch" type="xml">
                <search string="Buscar Expedientes">
                    <field name="numero_empleado" string="Número de Empleado" 
                        filter_domain="[('numero_empleado', 'ilike', self)]"/>
                    
                    <field name="employee_id" string="Nombre del Empleado"/>

                    <separator/>
                    <filter string="Activos" name="active" domain="[('employee_status', '=', 'active')]"/>
                    <filter string="Inactivos" name="inactive" domain="[('employee_status', '=', 'inactive')]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Empleado" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Tipo de Registro" name="group_by_tipo" context="{'group_by': 'tipo_registro'}"/>
                        <filter string="Fecha" name="group_by_fecha" context="{'group_by': 'fecha_movimiento'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_employee_expedient_form" model="ir.ui.view">
            <field name="name">employee.expedient.form</field>
            <field name="model">employee.expedient</field>
            <field name="arch" type="xml">
                <form string="Expediente de Movimientos">
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id" readonly="1"/>
                                <field name="numero_empleado"/>
                                <field name="employee_status" widget="badge" 
                                    decoration-success="employee_status == 'active'" 
                                    decoration-danger="employee_status == 'inactive'"/>
                            </group>
                            <group>
                                <field name="tipo_registro" string="Último Movimiento"/>
                                <field name="fecha_movimiento" string="Fecha del Movimiento"/>
                                <field name="recontratable" widget="radio" options="{'horizontal': true}"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Cálculo de Vacaciones" name="vacaciones">
                                <group>
                                    <group string="Estado de Antigüedad">
                                        <field name="antiguedad" readonly="1"/>
                                        <field name="dias_vacaciones_ley" readonly="1"/>
                                        <field name="fecha_ultima_renovacion" readonly="1"/>
                                    </group>
                                    <group string="Saldos de Días">
                                        <field name="dias_vacaciones_ajuste"/>
                                        <field name="dias_vacaciones_saldo_inicial" readonly="1"/>
                                        <field name="dias_vacaciones_utilizados" readonly="1"/>
                                        <field name="dias_vacaciones_disponibles" readonly="1" 
                                            decoration-info="True" font-weight="bold"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Historial de Movimientos" name="historial">
                                <field name="history_ids" readonly="1">
                                    <list decoration-info="tipo_movimiento == 'alta'" 
                                        decoration-danger="tipo_movimiento == 'baja'" 
                                        decoration-success="tipo_movimiento == 'reingreso'">
                                        <field name="fecha"/>
                                        <field name="tipo_movimiento" widget="badge"/>
                                        <field name="motivo"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Documentación de Baja/Renuncia" name="documentacion">
                                <group>
                                    <group string="Archivos">
                                        <field name="hoja_renuncia_convenio" filename="nombre_hoja_renuncia" widget="binary"/>
                                        <field name="nombre_hoja_renuncia" invisible="1"/>
                                        
                                        <field name="encuesta" filename="nombre_encuesta" widget="binary"/>
                                        <field name="nombre_encuesta" invisible="1"/>
                                    </group>
                                    <group string="Detalles Adicionales">
                                        <field name="motivo_baja" placeholder="Detalles del motivo de la última baja..."/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="employee_expedient_action" model="ir.actions.act_window">
            <field name="name">Expedientes de Movimiento</field>
            <field name="res_model">employee.expedient</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_employee_expedient_search"/> <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea un nuevo registro de alta, baja o reingreso.
                </p>
            </field>
        </record>
        
        <record id="view_hr_employee_form_inherit_expedient" model="ir.ui.view">
                    <field name="name">hr.employee.form.inherit.expedient</field>
                    <field name="model">hr.employee</field>
                    <field name="inherit_id" ref="hr.view_employee_form"/>
                    <field name="arch" type="xml">
                        
                        <xpath expr="//notebook" position="inside">
                            <page string="Historial de Movimientos">
                                <field name="expedient_ids">
                                    <list editable="bottom">
                                        <field name="tipo_registro"/>
                                        <field name="fecha_movimiento"/>
                                        <field name="recontratable" widget="toggle_button" options="{'positive': 'si', 'negative': 'no', 'default': 'n/a'}"/>
                                    </list>
                                    <form>
                                        <group>
                                            <field name="employee_id" invisible="1"/>
                                            <field name="tipo_registro"/>
                                            <field name="fecha_movimiento"/>
                                            <field name="recontratable"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                        </xpath>
                    </field>
        </record>

        <record id="view_employee_form_inherit_ver_expediente_button" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.ver.expediente.button</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="zkteco_realtime_connector.view_employee_form_biometric"/>
            <field name="arch" type="xml">

                <xpath expr="//button[@name='%(zkteco_realtime_connector.action_register_attendance)d']" position="before">
                    <button name="action_view_expedient"
                            type="object"
                            string="Ver Expediente"
                            class="btn-secondary"/>
                    <button name="action_view_warnings"
                            type="object"
                            string="Amonestaciones"
                            class="btn-secondary"/>
                    <button name="action_view_overtime"
                            type="object"
                            string="Tiempo Extra"
                            class="btn-secondary"/>
                    <button name="action_view_documents"
                            type="object"
                            string="Archivos"
                            class="btn-secondary"/>
                </xpath>

            </field>
        </record>

        <record id="view_employee_form_inherit_baja_button" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.baja.button</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">

                <xpath expr="//header" position="inside">
                    <button name="action_open_expedient_baja_wizard"
                            type="object"
                            string="Registrar Baja"
                            class="btn-primary"
                            invisible="employee_status == 'inactive'"/>
                </xpath>

            </field>
        </record>

        <record id="view_employee_form_inherit_reingreso_button" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.reingreso.button</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">

                <xpath expr="//header" position="inside">
                    <button name="action_open_expedient_reingreso_wizard"
                            type="object"
                            string="Registrar Reingreso"
                            class="btn-primary"
                            invisible="employee_status == 'active'"/>
                </xpath>

            </field>
        </record>

        <record id="view_hr_employee_form_inherit_expedient" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.expedient</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="fecha_ingreso_manual" invisible="context.get('active_id')"/>
                </xpath>

                </field>
        </record>

    </data>
</odoo>