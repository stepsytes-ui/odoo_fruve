<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_maintenance_request_form" model="ir.ui.view">
        <field name="name">maintenance.request.form</field>
        <field name="model">fruve.maintenance.request</field>
        <field name="arch" type="xml">
            <form string="Orden de Mantenimiento">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="folio"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="solicitante_id"/>
                            <field name="area_id"/>
                            <field name="clasificacion"/>
                            <field name="tipo_id"/>
                        </group>
                        <group>
                            <field name="prioridad"/>
                            <field name="tiempo_extra"/>
                            <field name="technician_ids" widget="many2many_tags"/>
                            <field name="fecha_cierre"/>
                            <field name="motivo_no_realizacion_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción y Solución">
                            <group>
                                <field name="descripcion"/>
                                <field name="solucion"/>
                                <field name="herramientas"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree / List View -->
    <record id="view_maintenance_request_tree" model="ir.ui.view">
        <field name="name">maintenance.request.list</field>
        <field name="model">fruve.maintenance.request</field>
        <field name="arch" type="xml">
            <list string="Órdenes de Mantenimiento">
                <field name="folio"/>
                <field name="solicitante_id"/>
                <field name="area_id"/>
                <field name="clasificacion"/>
                <field name="prioridad"/>
                <field name="fecha_cierre"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_maintenance_request" model="ir.actions.act_window">
        <field name="name">Órdenes de Mantenimiento</field>
        <field name="res_model">fruve.maintenance.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>