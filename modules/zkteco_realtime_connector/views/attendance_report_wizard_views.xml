<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista formulario del wizard -->
        <record id="view_attendance_report_wizard_form" model="ir.ui.view">
            <field name="name">attendance.report.wizard.form</field>
            <field name="model">attendance.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Reporte Personalizado de Asistencia">
                    <group>
                        <field name="open_from_employee" invisible="1" />
                        <group>
                            <field name="company_id" readonly="1" />
                            <field name="period_mode" widget="radio" invisible="not open_from_employee" />
                            <field name="date_from" invisible="open_from_employee and period_mode == 'full'" />
                            <field name="date_to" invisible="open_from_employee and period_mode == 'full'" />
                        </group>
                        <group>
                            <field name="show_archived" invisible="open_from_employee" />
                            <field name="employee_id"
                                invisible="open_from_employee"
                                domain="[('company_id', '=', company_id), ('active', '=', False)] if show_archived else [('company_id', '=', company_id)]"
                                context="{'active_test': False}" />
                        </group>
                    </group>
                    <footer>
                        <button name="action_preview_report" string="Vista Previa" type="object" class="btn-secondary" />
                        <button name="action_generate_report" string="Descargar Excel" type="object" class="btn-primary" />
                        <button string="Cancelar" class="btn-default" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <!-- Acción para abrir el wizard -->
        <record id="attendance_report_wizard_action" model="ir.actions.act_window">
            <field name="name">Reporte Personalizado de Asistencia</field>
            <field name="res_model">attendance.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_open_from_employee': False, 'default_period_mode': 'range'}</field>
        </record>
    </data>
</odoo>
