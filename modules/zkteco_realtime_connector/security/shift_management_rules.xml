<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Regla para Gestión de Turnos - Multi-compañía -->
        <record id="shift_management_multi_company_rule" model="ir.rule">
            <field name="name">Shift Management: Multi-company</field>
            <field name="model_id" ref="model_shift_management"/>
            <field name="domain_force">[
                '|',
                    ('company_id', '=', False),
                    ('company_id', 'in', company_ids)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
