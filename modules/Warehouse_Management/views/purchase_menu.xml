            parent="menu_almacen_root"
            sequence="70"
            groups="Warehouse_Management.group_compras_encargado,Warehouse_Management.group_compras_almacenista"
        />

        <record id="compras_supplier_action" model="ir.actions.act_window">
            <field name="name">Proveedores</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="domain">['|', ('supplier_rank', '&gt;', 0), ('compras_product_ids', '!=', False)]</field>
            <field name="context">{'default_company_type': 'company', 'default_supplier_rank': 1}</field>
        </record>

        <record id="compras_uom_action" model="ir.actions.act_window">
            <field name="name">Unidades de Medida</field>
            <field name="res_model">uom.uom</field>
            <field name="view_mode">list,form</field>
        </record>

