<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="overtime.OvertimeDashboard" owl="1">
    <div class="o_overtime_dashboard container-fluid p-3 bg-light" style="margin-bottom: 16px; border-radius: 8px;">

        <div t-if="state.loading" class="text-center">
            <i class="fa fa-spinner fa-spin fa-2x text-primary"/>
            <p class="mt-2">Cargando datos de tiempo extra...</p>
        </div>

        <div t-if="!state.loading">
            <div class="row mb-3 align-items-center">
                <div class="col-md-6">
                    <h4 class="fw-bold mb-0">Dashboard de Tiempo Extra </h4>
                </div>
                <div class="col-md-6 text_end d-flex align-items-center justify-content-end gap-2">
                    <label class="fw-bold small me-2">Desde:</label>
                    <input type="date" t-model="state.start_date" class="form-control form-control-sm w-auto"/>
                    
                    <label class="fw-bold small ms-2 me-2">Hasta:</label>
                    <input type="date" t-model="state.end_date" class="form-control form-control-sm w-auto"/>

                    <button class="btn btn-sm btn-primary ms-2 o_overtime_print_hide" t-on-click="_onRefresh" title="Refrescar">
                        <i class="fa fa-refresh"/>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary ms-1 o_overtime_print_hide" t-on-click="onPrintDashboard" title="Imprimir tabla">
                        <i class="fa fa-print me-1"/>
                        Imprimir
                    </button>
                </div>
            </div>

            <!-- Tabla de detalles de empleados -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0 text-white">Detalles de Tiempo Extra por Empleado</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered mb-0" style="font-size: 0.85rem;">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="text-center align-middle" rowspan="2" style="width: 80px; vertical-align: middle;">No. Emp</th>
                                            <th class="text-center align-middle" rowspan="2" style="width: 150px; vertical-align: middle;">Nombre</th>
                                            <th class="text-center align-middle" rowspan="2" style="width: 100px; vertical-align: middle;">Salario Diario</th>
                                            <!-- Columnas dinámicas por día -->
                                            <th t-foreach="state.tableHeaders" t-as="header" t-key="header.date" 
                                                class="text-center" colspan="2" style="background-color: #e3f2fd;">
                                                <strong><t t-esc="header.day_label"/></strong>
                                            </th>
                                            <th class="text-center align-middle bg-success text-white" rowspan="2" style="width: 100px; vertical-align: middle;">Total Hrs</th>
                                            <th class="text-center align-middle bg-success text-white" rowspan="2" style="width: 120px; vertical-align: middle;">Total $</th>
                                        </tr>
                                        <tr>
                                            <!-- Sub-encabezados: Hora y $ para cada día -->
                                            <t t-foreach="state.tableHeaders" t-as="header" t-key="'sub_' + header.date">
                                                <th class="text-center" style="width: 60px; background-color: #f5f5f5;">Hora</th>
                                                <th class="text-center" style="width: 80px; background-color: #f5f5f5;">$</th>
                                            </t>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.tableRows" t-as="row" t-key="row.employee_number" 
                                            t-on-click="() => this.onClickRow(row.employee_number, row.employee_name)"
                                            style="cursor: pointer;"
                                            class="overtime-row">
                                            <td class="text-center align-middle">
                                                <t t-esc="row.employee_number"/>
                                            </td>
                                            <td class="text-left align-middle">
                                                <t t-esc="row.employee_name"/>
                                            </td>
                                            <td class="text-right align-middle">
                                                $<t t-esc="(row.daily_rate || 0).toFixed(2)"/>
                                            </td>
                                            <!-- Datos por día -->
                                            <t t-foreach="state.tableHeaders" t-as="header" t-key="'data_' + header.date">
                                                <t t-set="dayData" t-value="row.days[header.date] || {hours: 0, amount: 0}"/>
                                                <td class="text-center align-middle">
                                                    <t t-esc="(dayData.hours || 0).toFixed(2)"/>h
                                                </td>
                                                <td class="text-right align-middle">
                                                    $<t t-esc="(dayData.amount || 0).toFixed(2)"/>
                                                </td>
                                            </t>
                                            <td class="text-center align-middle fw-bold">
                                                <t t-esc="(row.total_hours || 0).toFixed(2)"/>h
                                            </td>
                                            <td class="text-right align-middle fw-bold text-success">
                                                $<t t-esc="(row.total_amount || 0).toFixed(2)"/>
                                            </td>
                                        </tr>
                                        <tr t-if="!state.tableRows || state.tableRows.length === 0">
                                            <td t-att-colspan="3 + (state.tableHeaders.length * 2) + 2" class="text-center text-muted p-4">
                                                No hay datos de tiempo extra para el período seleccionado
                                            </td>
                                        </tr>
                                        <!-- Fila de totales -->
                                        <tr t-if="state.tableRows &amp;&amp; state.tableRows.length > 0" class="table-primary fw-bold">
                                            <td colspan="3" class="text-center align-middle">
                                                <strong>TOTALES</strong>
                                            </td>
                                            <!-- Totales por día -->
                                            <t t-foreach="state.tableHeaders" t-as="header" t-key="'total_' + header.date">
                                                <t t-set="dayTotal" t-value="state.columnTotals[header.date] || {hours: 0, amount: 0}"/>
                                                <td class="text-center align-middle bg-info text-white">
                                                    <t t-esc="(dayTotal.hours || 0).toFixed(2)"/>h
                                                </td>
                                                <td class="text-right align-middle bg-info text-white">
                                                    $<t t-esc="(dayTotal.amount || 0).toFixed(2)"/>
                                                </td>
                                            </t>
                                            <!-- Gran total -->
                                            <td class="text-center align-middle bg-success text-white">
                                                <t t-esc="(state.grandTotalHours || 0).toFixed(2)"/>h
                                            </td>
                                            <td class="text-right align-middle bg-success text-white">
                                                $<t t-esc="(state.grandTotalAmount || 0).toFixed(2)"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </t>
</templates>
