<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Vista de Lista/list -->
        <record id="view_hr_suspension_list" model="ir.ui.view">
            <field name="name">hr.suspension.list</field>
            <field name="model">hr.suspension</field>
            <field name="arch" type="xml">
                <list string="Suspensiones">
                    <field name="name"/>
                    <field name="biometric_id" string="No. Empleado" optional="show"/>
                    <field name="employee_name" string="Empleado"/>
                    <field name="supervisor_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="duration_days" string="Días"/>
                    <field name="state" widget="badge" 
                           decoration-info="state == 'draft'"
                           decoration-warning="state == 'confirm'"
                           decoration-success="state == 'validate'"
                           decoration-danger="state == 'refuse'"
                           decoration-muted="state == 'cancel'"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- Vista de Formulario -->
        <record id="view_hr_suspension_form" model="ir.ui.view">
            <field name="name">hr.suspension.form</field>
            <field name="model">hr.suspension</field>
            <field name="arch" type="xml">
                <form string="Suspensión de Empleado">
                    <header>
                        <button name="action_confirm" string="Confirmar" type="object" 
                                invisible="state != 'draft'" class="btn-primary"/>
                        <button name="action_validate" string="Aprobar" type="object" 
                                invisible="state != 'confirm'" class="btn-primary"/>
                        <button name="action_refuse" string="Rechazar" type="object" 
                                invisible="state not in ['draft', 'confirm']" class="btn-warning"/>
                        <button name="action_cancel" string="Cancelar" type="object" 
                                invisible="state in ['cancel', 'refuse']" class="btn-secondary"/>
                        <button name="action_draft" string="Regresar a Borrador" type="object" 
                                invisible="state not in ['refuse', 'cancel']"/>
                        <field name="state" widget="statusbar" 
                               statusbar_visible="draft,confirm,validate"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                                <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                            </button>
                        </div>
                        
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="biometric_id"/>
                                <field name="supervisor_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            </group>
                            <group>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="duration_days"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        
                        <group>
                            <field name="reason" placeholder="Describa el motivo de la suspensión..."/>
                        </group>
                        
                        <notebook>
                            <page string="Información Adicional">
                                <group>
                                    <field name="leave_id" readonly="1"/>
                                    <field name="notes" placeholder="Notas adicionales sobre la suspensión..."/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista de Búsqueda/Filtros -->
        <record id="view_hr_suspension_search" model="ir.ui.view">
            <field name="name">hr.suspension.search</field>
            <field name="model">hr.suspension</field>
            <field name="arch" type="xml">
                <search string="Buscar Suspensiones">
                    <field name="name" string="Referencia"/>
                    <field name="employee_id" string="Empleado"/>
                    <field name="biometric_id" string="Número de Empleado"/>
                    <field name="supervisor_id" string="Supervisor"/>
                    
                    <filter string="Borradores" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Confirmadas" name="confirm" domain="[('state', '=', 'confirm')]"/>
                    <filter string="Aprobadas" name="validate" domain="[('state', '=', 'validate')]"/>
                    <filter string="Rechazadas" name="refuse" domain="[('state', '=', 'refuse')]"/>
                    
                    <separator/>
                    <filter string="Este Mes" name="this_month" 
                            domain="[('date_from', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                     ('date_from', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Este Año" name="this_year" 
                            domain="[('date_from', '&gt;=', (context_today() - relativedelta(month=1, day=1)).strftime('%Y-%m-%d')),
                                     ('date_from', '&lt;', (context_today() + relativedelta(years=1, month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                    
                    <separator/>
                    <filter string="Archivadas" name="inactive" domain="[('active', '=', False)]"/>
                    
                    <group expand="0" string="Agrupar Por">
                        <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Supervisor" name="group_supervisor" context="{'group_by': 'supervisor_id'}"/>
                        <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Fecha de Inicio" name="group_date_from" context="{'group_by': 'date_from'}"/>
                        <filter string="Compañía" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Acción de Ventana -->
        <record id="action_hr_suspension" model="ir.actions.act_window">
            <field name="name">Suspensiones</field>
            <field name="res_model">hr.suspension</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_hr_suspension_search"/>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear una nueva Suspensión
                </p>
                <p>
                    Las suspensiones se crean principalmente desde el módulo de ausencias (hr.leave) 
                    al seleccionar el tipo "Suspensión" y asignar un supervisor.
                </p>
            </field>
        </record>

        <!-- Extender vista de hr.leave para mostrar campo suspension_id cuando es suspensión -->
        <record id="view_hr_leave_form_suspension" model="ir.ui.view">
            <field name="name">hr.leave.form.suspension</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">
                <!-- Agregar campo invisible para suspension_id -->
                <xpath expr="//field[@name='employee_id']" position="after">
                    <field name="is_suspension" invisible="1"/>
                    <field name="suspension_id" invisible="1"/>
                </xpath>
            </field>
        </record>

        <!-- Extender vista de hr_employee para agregar botón de suspensiones -->
        <record id="view_hr_employee_form_suspension_button" model="ir.ui.view">
            <field name="name">hr.employee.form.suspension.button</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="employee_modifications.view_employee_form_inherit_ver_expediente_button"/>
            <field name="arch" type="xml">
                <button name="action_view_documents" position="after">
                    <button name="action_view_suspensions"
                            type="object"
                            string="Suspensiones"
                            class="btn-secondary"/>
                </button>
            </field>
        </record>

    </data>
</odoo>
