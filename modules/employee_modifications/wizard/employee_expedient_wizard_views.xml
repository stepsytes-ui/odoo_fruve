<odoo>
    <data>
       <record id="view_employee_expedient_baja_wizard_form" model="ir.ui.view">
            <field name="model">employee.expedient.baja.wizard</field>
            <field name="arch" type="xml">
                <form string="Registrar Baja de Empleado">
                    <sheet>
                        <group>
                            <group string="Información General">
                                <field name="employee_id" readonly="1"/>
                                <field name="fecha_movimiento"/>
                                <field name="recontratable" widget="radio"/>
                            </group>
                            <group string="Motivos de Salida">
                                <field name="departure_reason_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="motivo_baja" placeholder="Explique detalladamente el motivo..."/>
                            </group>
                        </group>
                        
                        <separator string="Documentación Requerida"/>
                        <group>
                            <field name="hoja_renuncia_convenio" filename="nombre_hoja_renuncia"/>
                            <field name="nombre_hoja_renuncia" invisible="1"/>
                        </group>
                        
                        <separator string="Documentación Opcional"/>
                        <group>
                            <field name="encuesta" filename="nombre_encuesta"/>
                            <field name="nombre_encuesta" invisible="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm_baja" string="Confirmar Baja y Archivar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_employee_expedient_reingreso_wizard_form" model="ir.ui.view">
            <field name="model">employee.expedient.reingreso.wizard</field>
            <field name="arch" type="xml">
                <form string="Registrar Reingreso del Empleado">
                    <sheet>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="fecha_movimiento"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm_reingreso" string="Confirmar Reingreso" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>