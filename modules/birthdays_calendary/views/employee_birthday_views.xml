<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vista de Calendario -->
    <record id="view_employee_birthday_calendar" model="ir.ui.view">
        <field name="name">employee.birthday.calendar</field>
        <field name="model">employee.birthday</field>
        <field name="arch" type="xml">
            <calendar string="Cumpleaños de Empleados" 
                      date_start="birthday_this_year" 
                      mode="month"
                      quick_create="0"
                      create="0"
                      delete="0"
                      color="department_id"
                      event_open_popup="true">
                <field name="name"/>
                <field name="employee_id" invisible="1"/>
                <field name="age"/>
                <field name="department_id" invisible="1"/>
                <field name="biometric_id" invisible="1"/>
            </calendar>
        </field>
    </record>

    <!-- Vista de Lista -->
    <record id="view_employee_birthday_tree" model="ir.ui.view">
        <field name="name">employee.birthday.tree</field>
        <field name="model">employee.birthday</field>
        <field name="arch" type="xml">
            <list string="Cumpleaños de Empleados" create="0" delete="0" edit="0">
                <field name="biometric_id" string="No. Empleado"/>
                <field name="employee_id"/>
                <field name="birthday_date" string="Fecha de Nacimiento"/>
                <field name="birthday_this_year" string="Cumpleaños Este Año"/>
                <field name="age"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Vista de Formulario (Popup) -->
    <record id="view_employee_birthday_form" model="ir.ui.view">
        <field name="name">employee.birthday.form</field>
        <field name="model">employee.birthday</field>
        <field name="arch" type="xml">
            <form string="Cumpleaños" create="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="biometric_id" string="No. Empleado"/>
                            <field name="employee_id"/>
                            <field name="birthday_date" string="Fecha de Nacimiento"/>
                        </group>
                        <group>
                            <field name="birthday_this_year" string="Cumpleaños Este Año"/>
                            <field name="age"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de Búsqueda -->
    <record id="view_employee_birthday_search" model="ir.ui.view">
        <field name="name">employee.birthday.search</field>
        <field name="model">employee.birthday</field>
        <field name="arch" type="xml">
            <search string="Buscar Cumpleaños">
                <field name="employee_id"/>
                <field name="biometric_id" string="No. Empleado"/>
                <field name="department_id"/>
                <field name="job_id"/>
                
                <filter name="this_month" string="Este Mes" 
                        domain="[('birthday_this_year', '&gt;=', time.strftime('%%Y-%%m-01')), 
                                ('birthday_this_year', '&lt;=', (datetime.datetime.now() + relativedelta(day=31)).strftime('%%Y-%%m-%%d'))]"/>
                
                <filter name="today" string="Hoy" 
                        domain="[('birthday_this_year', '=', time.strftime('%%Y-%%m-%%d'))]"/>
                
                <separator/>
                
                <group expand="0" string="Agrupar Por">
                    <filter name="group_department" string="Departamento" 
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_job" string="Puesto" 
                            context="{'group_by': 'job_id'}"/>
                    <filter name="group_month" string="Mes" 
                            context="{'group_by': 'birthday_this_year:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_employee_birthday_calendar" model="ir.actions.act_window">
        <field name="name">Cumpleaños</field>
        <field name="res_model">employee.birthday</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Calendario de Cumpleaños de Empleados
            </p>
            <p>
                Aquí puedes ver todos los cumpleaños de tus empleados organizados en un calendario.
            </p>
        </field>
    </record>

    <!-- Menú Principal -->
    <menuitem id="menu_employee_birthday_root"
              name="Cumpleaños"
              parent="calendar.mail_menu_calendar"
              action="action_employee_birthday_calendar"
              sequence="10"/>

</odoo>
