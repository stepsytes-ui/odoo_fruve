<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="group_customer_service" model="res.groups">
      <field name="name">Permiso para customer service</field>
      <field name="comment">Acceso al módulo de Customer Service y a los productos de producción</field>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="base.user_admin" model="res.users">
      <field name="groups_id" eval="[(4, ref('group_customer_service'))]"/>
    </record>
  </data>

  <data noupdate="1">
    <!-- Usuario/Almacenista Compras no ven los productos de producción -->
    <record id="rule_compras_product_hide_production" model="ir.rule">
      <field name="name">Compras Product: ocultar productos de producción</field>
      <field name="model_id" ref="Warehouse_Management.model_compras_product"/>
      <field name="domain_force">[('is_production', '=', False)]</field>
      <field name="groups" eval="[(4, ref('Warehouse_Management.group_compras_usuario')), (4, ref('Warehouse_Management.group_compras_almacenista'))]"/>
    </record>

    <!-- Customer Service ve todos los productos aunque también pertenezca a grupos de compras -->
    <record id="rule_compras_product_customer_service" model="ir.rule">
      <field name="name">Compras Product: acceso Customer Service</field>
      <field name="model_id" ref="Warehouse_Management.model_compras_product"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('group_customer_service'))]"/>
    </record>
  </data>
</odoo>