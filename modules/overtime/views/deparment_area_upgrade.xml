<odoo>
    <data>
        <record id="view_department_form_with_area" model="ir.ui.view">
            <field name="name">hr.department.form.area.extension</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="after">
                    <notebook>
                        <page string="Áreas y Empleados" name="department_areas_employees">
                            <field name="area_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="employee_count"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="department_id" invisible="1"/>
                                    </group>
                                    <notebook>
                                        <page string="Empleados del Área">
                                            <field name="employee_ids" readonly="1">
                                                <list>
                                                    <field name="name"/>
                                                </list>
                                            </field>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>
    </data>
</odoo>