<odoo>
    <data>
        <record id="view_employee_form_daily_rate" model="ir.ui.view">
            <field name="name">hr.employee.form.upgrade.daily.rate</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='personal_information']/group" position="inside">
                    <group string="Información Financiera">
                        <field name="daily_rate"/>
                    </group>
                    <group name="financial_filler_right"/> 
                </xpath>
                <xpath expr="//field[@name='department_id']" position="after">
                    <field name="area_id" domain="[('department_id', '=', department_id)]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>