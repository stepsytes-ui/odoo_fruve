<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_rejection_wizard_form" model="ir.ui.view">
        <field name="name">purchase.rejection.wizard.form</field>
        <field name="model">purchase.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Rechazar Solicitud de Compra">
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="rejection_reason" widget="text" placeholder="Escribe el motivo del rechazo..."/>
                </group>
                <footer>
                    <button string="Confirmar Rechazo" type="object" name="action_confirm_rejection" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
