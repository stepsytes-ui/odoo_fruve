<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_receipt_wizard_form" model="ir.ui.view">
        <field name="name">purchase.receipt.wizard.form</field>
        <field name="model">purchase.receipt.wizard</field>
        <field name="arch" type="xml">
            <form string="Checklist de Recepción">
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="warehouse_id"/>
                    <field name="location_id"/>
                    <field name="receiver_user_id"/>
                    <field name="request_missing"/>
                    <field name="cancellation_reason" string="Motivo (requerido para devolver)" placeholder="Material no recibido, incompleto o dañado..."/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="request_line_id" column_invisible="1" force_save="1"/>
                        <field name="product_id" readonly="1" force_save="1"/>
                        <field name="quantity_expected" readonly="1" force_save="1"/>
                        <field name="receipt_check"/>
                        <field name="quantity_received"/>
                        <field name="notes"/>
                    </list>
                </field>
                <footer>
                    <button string="Confirmar Recepción" type="object" name="action_confirm_receipt" class="btn-primary"/>
                    <button string="Cancelar y devolver orden" type="object" name="action_cancel_order" class="btn-danger" confirm="La orden se devolverá a Compras y no se agregará mercancía al inventario. ¿Continuar?"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
