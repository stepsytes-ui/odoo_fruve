<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de formulario para hr.permission -->
        <record id="view_hr_permission_form" model="ir.ui.view">
            <field name="name">hr.permission.form</field>
            <field name="model">hr.permission</field>
            <field name="arch" type="xml">
                <form string="Permiso">
                    <header>
                        <button name="action_confirm" string="Confirmar" type="object" 
                                invisible="state != 'draft'" class="btn-primary"/>
                        <button name="action_validate" string="Aprobar" type="object" 
                                invisible="state not in ['confirm', 'validate1']" class="btn-primary"/>
                        <button name="action_refuse" string="Rechazar" type="object" 
                                invisible="state not in ['confirm', 'validate1']" class="btn-warning"/>
                        <button name="action_cancel" string="Cancelar" type="object" 
                                invisible="state not in ['draft', 'confirm', 'validate1']" class="btn-danger"/>
                        <button name="action_draft" string="Volver a Borrador" type="object" 
                                invisible="state != 'cancel'"/>
                        <field name="state" widget="statusbar" 
                               statusbar_visible="draft,confirm,validate"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="biometric_id" readonly="1"/>
                                <field name="employee_name" readonly="1"/>
                                <field name="department_id" readonly="1"/>
                                <field name="supervisor_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            </group>
                            <group>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="duration_days" readonly="1"/>
                                <field name="permission_type"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="reason" placeholder="Describa el motivo del permiso..."/>
                        </group>
                        <group>
                            <field name="leave_id" readonly="1"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Vista de lista para hr.permission -->
        <record id="view_hr_permission_list" model="ir.ui.view">
            <field name="name">hr.permission.list</field>
            <field name="model">hr.permission</field>
            <field name="arch" type="xml">
                <list string="Permisos" decoration-info="state == 'draft'" 
                      decoration-muted="state in ['cancel', 'refuse']" 
                      decoration-success="state == 'validate'">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="biometric_id"/>
                    <field name="department_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="duration_days"/>
                    <field name="permission_type"/>
                    <field name="state" 
                           decoration-info="state == 'draft'" 
                           decoration-success="state == 'validate'" 
                           decoration-warning="state in ['confirm', 'validate1']" 
                           decoration-danger="state == 'refuse'" 
                           widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Vista de búsqueda para hr.permission -->
        <record id="view_hr_permission_search" model="ir.ui.view">
            <field name="name">hr.permission.search</field>
            <field name="model">hr.permission</field>
            <field name="arch" type="xml">
                <search string="Buscar Permisos">
                    <field name="name" string="Referencia"/>
                    <field name="employee_id"/>
                    <field name="biometric_id"/>
                    <field name="department_id"/>
                    <field name="permission_type"/>
                    <separator/>
                    <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Confirmado" name="confirm" domain="[('state', '=', 'confirm')]"/>
                    <filter string="Aprobado" name="validate" domain="[('state', '=', 'validate')]"/>
                    <filter string="Rechazado" name="refuse" domain="[('state', '=', 'refuse')]"/>
                    <filter string="Cancelado" name="cancel" domain="[('state', '=', 'cancel')]"/>
                    <separator/>
                    <filter string="Mes Actual" name="current_month" 
                            domain="[('date_from', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                     ('date_from', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Departamento" name="group_department" context="{'group_by': 'department_id'}"/>
                        <filter string="Tipo de Permiso" name="group_permission_type" context="{'group_by': 'permission_type'}"/>
                        <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Fecha Inicio" name="group_date_from" context="{'group_by': 'date_from'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Vista Kanban para hr.permission -->
        <record id="view_hr_permission_kanban" model="ir.ui.view">
            <field name="name">hr.permission.kanban</field>
            <field name="model">hr.permission</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="duration_days"/>
                    <field name="permission_type"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="row">
                                    <div class="col-12">
                                        <strong>
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <span>
                                            <i class="fa fa-user" title="Empleado"/> <field name="employee_id"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <span>
                                            <i class="fa fa-calendar" title="Periodo"/> 
                                            <field name="date_from"/> - <field name="date_to"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <span>
                                            <field name="permission_type"/>
                                        </span>
                                    </div>
                                    <div class="col-6 text-end">
                                        <field name="state" widget="badge" 
                                               decoration-info="state == 'draft'" 
                                               decoration-success="state == 'validate'" 
                                               decoration-warning="state in ['confirm', 'validate1']" 
                                               decoration-danger="state == 'refuse'"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Acción para abrir permisos -->
        <record id="action_hr_permission" model="ir.actions.act_window">
            <field name="name">Permisos</field>
            <field name="res_model">hr.permission</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear un nuevo permiso
                </p>
                <p>
                    Los permisos se crean automáticamente cuando se aprueba una ausencia con tipo que contenga la palabra "Permiso".
                    También puede crear permisos manualmente aquí.
                </p>
            </field>
        </record>


        <!-- Extender vista de hr.employee para agregar botón de Permisos -->
        <record id="view_employee_form_inherit_permission_button" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.permission.button</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="employee_modifications.view_employee_form_inherit_incapacity_button"/>
            <field name="arch" type="xml">
                <!-- Agregar botón de Permisos después del botón de Incapacidades -->
                <xpath expr="//button[@name='action_view_incapacities']" position="after">
                    <button name="action_view_permissions"
                            type="object"
                            string="Permisos"
                            class="btn-secondary"
                            groups="hr.group_hr_user"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
