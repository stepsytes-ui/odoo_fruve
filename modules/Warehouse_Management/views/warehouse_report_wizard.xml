<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista formulario del wizard de reportes -->
        <record id="warehouse_report_wizard_form" model="ir.ui.view">
            <field name="name">warehouse.report.wizard.form</field>
            <field name="model">warehouse.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Reportes de Almacén">
                    <sheet>
                        <div class="oe_title">
                            <h1>Generador de Reportes de Almacén</h1>
                            <p class="oe_read_only">
                                <i>Selecciona los parámetros para generar un reporte detallado de movimientos de almacén con gráficas interactivas.</i>
                            </p>
                        </div>

                        <group col="2">
                            <group>
                                <field name="company_id" readonly="1" />
                                <field name="report_type" />
                            </group>
                            <group>
                                <field name="show_chart_type" />
                                <field name="grouping_period" />
                            </group>
                        </group>

                        <separator string="Período de Reporte" />
                        <group col="2">
                            <group>
                                <field name="period_mode" widget="radio" />
                            </group>
                        </group>

                        <group col="2">
                            <group>
                                <field name="date_from" />
                            </group>
                            <group>
                                <field name="date_to" />
                            </group>
                        </group>

                        <separator string="Filtros Adicionales" />
                        <group col="1">
                            <group string="Almacenes a Incluir">
                                <field name="warehouse_ids" widget="many2many_tags" nolabel="1" />
                            </group>
                        </group>

                        <group col="1">
                            <group string="Tipos de Movimiento">
                                <field name="move_type_ids" widget="many2many_tags" nolabel="1" />
                            </group>
                        </group>
                    </sheet>

                    <footer>
                        <button 
                            string="👁 Ver Reporte" 
                            type="object" 
                            name="action_view_report" 
                            class="btn-primary" 
                        />
                        <button string="✕ Cancelar" class="btn-secondary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <!-- Acción para abrir el wizard -->
        <record id="warehouse_report_wizard_action" model="ir.actions.act_window">
            <field name="name">Reportes de Almacén</field>
            <field name="res_model">warehouse.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_report_type': 'movement_by_warehouse', 'default_grouping_period': 'month'}</field>
        </record>

        <!-- Menú para acceder al wizard de reportes -->
        <menuitem
            id="menu_almacen_reports"
            name="Reportes"
            parent="menu_almacen_root"
            action="warehouse_report_wizard_action"
            groups="Warehouse_Management.group_compras_encargado,Warehouse_Management.group_compras_almacenista"
            sequence="65"
        />
    </data>
</odoo>
