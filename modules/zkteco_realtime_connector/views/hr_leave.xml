<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Vista de Búsqueda/Filtros - Aplicable a todas las vistas de hr.leave -->
        <record id="view_hr_leave_filter_biometric" model="ir.ui.view">
            <field name="name">hr.leave.filter.biometric</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.view_hr_holidays_filter"/>
            <field name="arch" type="xml">
                <!-- Agregar campo biometric_id al buscador, antes del campo employee_id -->
                <xpath expr="//field[@name='employee_id']" position="before">
                    <field name="biometric_id" string="Número de Empleado"/>
                </xpath>
                
                <!-- Agregar filtro de agrupación por biometric_id -->
                <xpath expr="//filter[@name='group_employee']" position="after">
                    <filter string="Número de Empleado" name="group_by_biometric" 
                            domain="[]" context="{'group_by':'biometric_id'}"/>
                </xpath>
            </field>
        </record>

        <!-- Vista de Lista/Tree - Agregar columna biometric_id -->
        <record id="view_hr_leave_tree_biometric" model="ir.ui.view">
            <field name="name">hr.leave.tree.biometric</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
            <field name="arch" type="xml">
                <!-- Agregar columna de biometric_id antes del nombre del empleado -->
                <xpath expr="//field[@name='employee_id']" position="before">
                    <field name="biometric_id_numeric" string="No. Empleado" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Vista de Calendario - Agregar biometric_id en información del evento -->
        <record id="view_hr_leave_calendar_biometric" model="ir.ui.view">
            <field name="name">hr.leave.calendar.biometric</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_calendar"/>
            <field name="arch" type="xml">
                <!-- Agregar biometric_id como campo disponible en el calendario -->
                <xpath expr="//field[@name='employee_id']" position="after">
                    <field name="biometric_id"/>
                </xpath>
            </field>
        </record>

        <!-- Vista de Formulario - Mostrar biometric_id (solo lectura) -->
        <record id="view_hr_leave_form_biometric" model="ir.ui.view">
            <field name="name">hr.leave.form.biometric</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">
                <!-- Agregar biometric_id después del campo employee_id -->
                <xpath expr="//field[@name='employee_id']" position="after">
                    <field name="biometric_id" readonly="1"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
