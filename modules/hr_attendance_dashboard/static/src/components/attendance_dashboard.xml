<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_attendance_dashboard.AttendanceDashboard" owl="1">
        <div t-if="state.loading" class="o_hr_attendance_dashboard p-4 text-center">
            <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
            <p class="mt-2">Cargando datos...</p>
        </div>

        <div t-else="" class="o_hr_attendance_dashboard p-4">
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2">Dashboard de Asistencia</h1>
                <button class="btn btn-primary" t-on-click="_onRefreshClick">
                    <i class="fa fa-refresh me-1"/>
                    Refrescar
                </button>
            </div>

            <div class="row">
                
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-body text-center">
                            <h5 class="card-title">Bienvenido/a</h5>
                            <p class="fs-3 fw-bold text-primary">
                                <t t-esc="state.userName"/>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-body text-center">
                            <h5 class="card-title">Asistencias Totales</h5>
                            <p class="fs-3 fw-bold text-success">
                                <t t-esc="state.attendanceCount"/>
                            </p>
                            <small class="text-muted">Registros históricos</small>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>
</templates>