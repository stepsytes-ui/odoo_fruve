<odoo>
    <data noupdate="0">
        <record model="res.groups" id="group_time_off_security">
            <field name="name">Vista de permisos para guardias</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record model="ir.rule" id="hr_leave_current_day_security_rule">
            <field name="name">Permisos Aprobados Para Hoy</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>

            <field name="domain_force" eval="[
                ('state', 'in', ['validate', 'validate1']), 
                ('request_date_from', '&lt;=', time.strftime('%Y-%m-%d')),
                ('request_date_to', '&gt;=', time.strftime('%Y-%m-%d'))
            ]"/>

            <field name="groups" eval="[(4, ref('security_view_time_off.group_time_off_security'))]"/>
            <field name="perm_read" eval="True"/>
        </record>

        <record id="hr_holidays.hr_leave_rule_employee" model="ir.rule">
            <field name="name">Tiempo Personal: Empleados Solo Ven Su Propio</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="groups" eval="[(3, ref('security_view_time_off.group_time_off_security'))]"/> <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>