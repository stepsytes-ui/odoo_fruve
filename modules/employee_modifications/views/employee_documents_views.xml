<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Formulario de Documentos -->
    <record id="view_employee_documents_form" model="ir.ui.view">
        <field name="name">employee.documents.form</field>
        <field name="model">employee.documents</field>
        <field name="arch" type="xml">
            <form string="Documentos del Empleado">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="biometric_id"/>
                        </group>
                        <group>
                            <field name="employee_name"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documentos de Ingreso">
                            <group>
                                <group string="Identificación">
                                    <label for="identificacion_frente" string="Identificación (Frente)"/>
                                    <div>
                                        <field name="identificacion_frente" filename="identificacion_frente_filename" 
                                               widget="pdf_viewer" options="{'open_in_new_window': true}"/>
                                        <field name="identificacion_frente_filename" invisible="1"/>
                                    </div>
                                    
                                    <label for="identificacion_posterior" string="Identificación (Posterior)"/>
                                    <div>
                                        <field name="identificacion_posterior" filename="identificacion_posterior_filename" 
                                               widget="pdf_viewer" options="{'open_in_new_window': true}"/>
                                        <field name="identificacion_posterior_filename" invisible="1"/>
                                    </div>
                                    
                                    <label for="curp" string="CURP"/>
                                    <div>
                                        <field name="curp" filename="curp_filename" 
                                               widget="pdf_viewer" options="{'open_in_new_window': true}"/>
                                        <field name="curp_filename" invisible="1"/>
                                    </div>
                                </group>
                                <group string="Documentos Legales">
                                    <label for="carta_antecedentes" string="Carta no Antecedentes Penales"/>
                                    <div>
                                        <field name="carta_antecedentes" filename="carta_antecedentes_filename" 
                                               widget="pdf_viewer" options="{'open_in_new_window': true}"/>
                                        <field name="carta_antecedentes_filename" invisible="1"/>
                                    </div>
                                    
                                    <label for="antidoping" string="Antidoping"/>
                                    <div>
                                        <field name="antidoping" filename="antidoping_filename" 
                                               widget="pdf_viewer" options="{'open_in_new_window': true}"/>
                                        <field name="antidoping_filename" invisible="1"/>
                                    </div>
                                    
                                    <label for="buro_credito" string="Buró de Crédito"/>
                                    <div>
                                        <field name="buro_credito" filename="buro_credito_filename" 
                                               widget="pdf_viewer" options="{'open_in_new_window': true}"/>
                                        <field name="buro_credito_filename" invisible="1"/>
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Documentos Académicos">
                            <group>
                                <group>
                                    <label for="cedula_profesional" string="Cédula Profesional"/>
                                    <div>
                                        <field name="cedula_profesional" filename="cedula_profesional_filename" 
                                               widget="pdf_viewer" options="{'open_in_new_window': true}"/>
                                        <field name="cedula_profesional_filename" invisible="1"/>
                                    </div>
                                    
                                    <label for="titulo" string="Título"/>
                                    <div>
                                        <field name="titulo" filename="titulo_filename" 
                                               widget="pdf_viewer" options="{'open_in_new_window': true}"/>
                                        <field name="titulo_filename" invisible="1"/>
                                    </div>
                                </group>
                                <group>
                                    <label for="certificado_estudios" string="Certificado de Estudios"/>
                                    <div>
                                        <field name="certificado_estudios" filename="certificado_estudios_filename" 
                                               widget="pdf_viewer" options="{'open_in_new_window': true}"/>
                                        <field name="certificado_estudios_filename" invisible="1"/>
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Otros Documentos">
                            <group>
                                <group>
                                    <label for="contrato_confidencialidad" string="Contrato de Confidencialidad"/>
                                    <div>
                                        <field name="contrato_confidencialidad" filename="contrato_confidencialidad_filename" 
                                               widget="pdf_viewer" options="{'open_in_new_window': true}"/>
                                        <field name="contrato_confidencialidad_filename" invisible="1"/>
                                    </div>
                                    
                                    <label for="estudio_socioeconomico" string="Estudio Socio Económico"/>
                                    <div>
                                        <field name="estudio_socioeconomico" filename="estudio_socioeconomico_filename" 
                                               widget="pdf_viewer" options="{'open_in_new_window': true}"/>
                                        <field name="estudio_socioeconomico_filename" invisible="1"/>
                                    </div>
                                </group>
                                <group>
                                    <label for="resguardo_baja" string="Resguardo de Baja"/>
                                    <div>
                                        <field name="resguardo_baja" filename="resguardo_baja_filename" 
                                               widget="pdf_viewer" options="{'open_in_new_window': true}"/>
                                        <field name="resguardo_baja_filename" invisible="1"/>
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div> -->
            </form>
        </field>
    </record>

    <!-- Vista de Lista de Documentos -->
    <record id="view_employee_documents_list" model="ir.ui.view">
        <field name="name">employee.documents.list</field>
        <field name="model">employee.documents</field>
        <field name="arch" type="xml">
            <list string="Documentos de Empleados">
                <field name="biometric_id" string="No. Empleado"/>
                <field name="employee_name" string="Nombre"/>
                <field name="identificacion_frente" filename="identificacion_frente_filename" widget="binary" string="ID Frente"/>
                <field name="identificacion_posterior" filename="identificacion_posterior_filename" widget="binary" string="ID Posterior"/>
                <field name="curp" filename="curp_filename" widget="binary" string="CURP"/>
                <field name="carta_antecedentes" filename="carta_antecedentes_filename" widget="binary" string="Antecedentes"/>
            </list>
        </field>
    </record>

    <!-- Vista de Búsqueda -->
    <record id="view_employee_documents_search" model="ir.ui.view">
        <field name="name">employee.documents.search</field>
        <field name="model">employee.documents</field>
        <field name="arch" type="xml">
            <search string="Buscar Documentos">
                <field name="biometric_id" string="Número de Empleado"
                       filter_domain="[('biometric_id', 'ilike', self)]"/>
                <field name="employee_name" string="Nombre Empleado"
                       filter_domain="[('employee_name', 'ilike', self)]"/>
                <field name="employee_id" string="Empleado"/>
                <separator/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_employee_documents" model="ir.actions.act_window">
        <field name="name">Archivos de Empleados</field>
        <field name="res_model">employee.documents</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Agregar documentos del empleado
            </p>
            <p>
                Gestione todos los documentos y archivos PDF de los empleados.
            </p>
        </field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_employee_documents"
              name="Archivos de Empleados"
              parent="hr.menu_hr_root"
              action="action_employee_documents"
              sequence="65"/>

</odoo>
